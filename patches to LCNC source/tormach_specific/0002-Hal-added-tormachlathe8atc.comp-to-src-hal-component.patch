From 824c24e0493399318dc8094b436fff786b35495b Mon Sep 17 00:00:00 2001
From: Daniel Rogge <drogge@tormach.com>
Date: Mon, 17 Sep 2012 11:28:26 -0500
Subject: [PATCH 2/2] Hal: added tormachlathe8atc.comp to src/hal/components

---
 src/hal/components/tormachlathe8atc.comp |   67 ++++++++++++++++++++++++++++++
 1 files changed, 67 insertions(+), 0 deletions(-)
 create mode 100644 src/hal/components/tormachlathe8atc.comp

diff --git a/src/hal/components/tormachlathe8atc.comp b/src/hal/components/tormachlathe8atc.comp
new file mode 100644
index 0000000..b6f9554
--- /dev/null
+++ b/src/hal/components/tormachlathe8atc.comp
@@ -0,0 +1,67 @@
+
+component tormachlathe8atc "Tormach Lathe 8 Position Automatic Tool Changer HAL Component";
+
+license "©2012 Tormach® LLC. All rights reserved.";
+author "Tormach, LLC";
+
+// connect this to iocontrol.0.tool-change
+pin in bit tool_change;
+
+// connect this to a HAL input pin, e.g. hm2_5i25.0.gpio.010.in_not
+pin in bit tool_changed;
+
+// connect this to iocontrol.0.tool-prep-number
+pin in s32 tool_prep_number;
+
+// connect this to a HAL output pin, e.g. hm2_5i25.0.gpio.011.out
+pin out bit tool_change_out;
+
+// connect this to iocontrol.0.tool-changed
+pin out bit tool_changed_out;
+
+// connect this to a HAL pwmgen value, e.g. hm2_5i25.0.pwmgen.00.value
+pin out float pwm_duty_cycle;
+
+// 5 and 95 are both "not valid" tool numbers for the 
+variable float min_pwm = 5.0;
+variable float max_pwm = 95.0;
+
+function _ "Tormach 8 position lathe tool changer";
+
+;;
+
+FUNCTION(_) {
+
+    // compute PWM duty cycle from tool number 1 - 8
+    // 5% and 95% => "no tool"
+    // 15% => tool #1
+    // 25% => tool #2
+    // 35% => tool #3
+    // 45% => tool #4
+    // 55% => tool #5
+    // 65% => tool #6
+    // 75% => tool #7
+    // 85% => tool #8
+
+    double duty = (tool_prep_number * 10.0) + 5.0;
+    if (duty < min_pwm) {
+        duty = min_pwm;
+    }
+    if (duty > max_pwm) {
+        duty = max_pwm;
+    }
+    pwm_duty_cycle = duty;
+
+    // convey the tool change request pin
+    tool_change_out = tool_change;
+
+    // convey the tool change complete pin
+    if (tool_prep_number >= 1 && tool_prep_number <=8) {
+        tool_changed_out = tool_changed;
+    }
+    else {
+        // outside range of changer always "changed"
+        tool_changed_out = 1;
+    }
+}
+
