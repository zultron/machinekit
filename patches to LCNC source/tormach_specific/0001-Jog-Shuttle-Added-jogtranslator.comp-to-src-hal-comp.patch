From 73e9bea18bc883c14d15b4e371f650c97d599305 Mon Sep 17 00:00:00 2001
From: Daniel Rogge <drogge@tormach.com>
Date: Mon, 17 Sep 2012 11:18:45 -0500
Subject: [PATCH] Jog Shuttle: Added jogtranslator.comp to src/hal/components

---
 src/hal/components/jogtranslator.comp |  217 +++++++++++++++++++++++++++++++++
 1 files changed, 217 insertions(+), 0 deletions(-)
 create mode 100644 src/hal/components/jogtranslator.comp

diff --git a/src/hal/components/jogtranslator.comp b/src/hal/components/jogtranslator.comp
new file mode 100644
index 0000000..c6372ec
--- /dev/null
+++ b/src/hal/components/jogtranslator.comp
@@ -0,0 +1,217 @@
+component jogtranslator;
+
+pin in bit ax_butt_0 "TRUE if button 0 pressed";
+pin in bit ax_butt_1 "TRUE if button 1 pressed";
+pin in bit ax_butt_2 "TRUE if button 2 pressed";
+pin in bit ax_butt_3 "TRUE if button 3 pressed";
+pin in bit ax_butt_4 "TRUE if button 4 pressed";
+
+pin in signed ring_raw "Signed value of jog ring position";
+
+pin in float min_speed "Minimum output value i.e. wheel in position 1";
+pin in float g_multiplier "Max output value for position 7 is min_speed * g_multiplier^6";
+
+description "Pre-compute g_multiplier as sixth-root on max_speed/min_speed";
+
+pin in unsigned radio_latching "Set true if you want the priority ax_butt signals to be latched";
+
+pin out bit ax_out_0_pos "Jog axis 0 in positive direction";
+pin out bit ax_out_0_neg "Jog axis 0 in negative direction";
+pin out bit ax_out_0_sel "Axis 0 is selected";
+
+pin out bit ax_out_1_pos "Jog axis 1 in positive direction";
+pin out bit ax_out_1_neg "Jog axis 1 in negative direction";
+pin out bit ax_out_1_sel "Axis 1 is selected";
+
+pin out bit ax_out_2_pos "Jog axis 2 in positive direction";
+pin out bit ax_out_2_neg "Jog axis 2 in negative direction";
+pin out bit ax_out_2_sel "Axis 2 is selected";
+
+pin out bit ax_out_3_pos "Jog axis 3 in positive direction";
+pin out bit ax_out_3_neg "Jog axis 3 in negative direction";
+pin out bit ax_out_3_sel "Axis 3 is selected";
+
+pin out bit ax_out_4_pos "Jog axis 4 in positive direction";
+pin out bit ax_out_4_neg "Jog axis 4 in negative direction";
+pin out bit ax_out_4_sel "Axis 4 is selected";
+
+pin out signed ax_selected_axis "Number of selected axis or -1 if none";
+
+pin out float ax_jog_speed "Translated jogging speed";
+
+pin in float smallest_step "Value of the smallest jogging step e.g. 0.001";
+pin in unsigned number_of_stepsizes "Count of different stepsizes to be generated";
+pin in bit cycle_stepsizes "moves to next size of step when this goes high. Wraps around in hitting number if sizes";
+
+
+pin out float jog_microstep_size "Size of desired step divided by 1000 as each wheel click is 1000 microsteps";
+pin out unsigned shuttle_step_index "Index to hal table of step sizes - smallest is 0 up to number_of_stepsizes - 1";
+pin in unsigned gui_step_index "Channel from GUI to hal table of step sizes - smallest is 0 up to number_of_stepsizes - 1";
+pin in bit is_metric "Pin to indicate current G20/21 status.  True when in G21, False in G20";
+
+
+
+function _ "This comp translates raw data from shuttle devices to drive jogging pins";
+
+option extra_setup;
+
+license "GPL";
+
+author "J A Prentice";
+
+variable float jt_speeds[8];
+variable signed latched_button;
+variable float last_min_speed;
+variable float last_g_multiplier;
+variable char waiting_stepsizes_release;
+variable unsigned step_size_index;
+variable float current_stepsize;
+variable char first_call;  // NZ on first entry to main loop
+
+;;
+
+// Rev C1 - 21 April 2012
+// Rev D1 - 23 May 2012 - Added pin input that creates a channel from the GUI to the hal step size table *dpr
+// Rev E1 - 16 Aug 2012 - Added pin input for metric/imperial handling
+
+
+EXTRA_SETUP() {
+
+// TODO - these speeds should be calculated from min_speed and max_speed in ini file.
+    jt_speeds[0] =   0.0;
+    jt_speeds[1] =   0.5;
+    jt_speeds[2] =   1.0;
+    jt_speeds[3] =   5.0;
+    jt_speeds[4] =  10.0;
+    jt_speeds[5] =  20.0;
+    jt_speeds[6] =  40.0;
+    jt_speeds[7] =  80.0;
+
+    last_min_speed = 1; // dummy initial values to pick up changes
+    last_g_multiplier = 1; 
+    latched_button = -1;
+
+    waiting_stepsizes_release = 0; // not awaiting release of cycle-stepsizes
+    step_size_index = 0;
+
+    first_call = 1; // used to do pin based init
+
+    return 0;
+}
+
+
+FUNCTION(_) { 
+
+signed int current_button = -1;  	// what we see this time
+signed int output_button = -1;  	// what we are going to output
+float g20_scale = 1;		// inch versus mm
+char pos, neg; 			// direction flags
+unsigned int iloop;
+
+	if (is_metric) g20_scale = 25.4;
+	if (ax_butt_0) 	current_button = 0;
+	else if (ax_butt_1) current_button = 1;	
+	else if (ax_butt_2) current_button = 2;	
+	else if (ax_butt_3) current_button = 3;	
+	else if (ax_butt_4) current_button = 4;	
+
+	if (current_button >= 0) { 
+		output_button = current_button;
+		if (radio_latching) { 			// need to remember this button
+		latched_button = current_button;
+		}
+	}
+	else output_button = latched_button;
+
+        // the former pos/neg computation set neg == TRUE when ring_raw == 0
+	// this seemed to disable wheel jogging after a CCW ring jog
+	// oddly, a CW ring jog restored wheel jogging
+	// 10MAY2012 Jason Penn
+   	//pos = (ring_raw > 0); neg = !pos;  // establish direction
+	neg = (ring_raw < 0); 
+	pos = (ring_raw > 0);
+
+// initialise outputs
+	ax_out_0_pos = 0;
+	ax_out_0_neg = 0;
+	ax_out_0_sel = 0;
+	ax_out_1_pos = 0;
+	ax_out_1_neg = 0;
+	ax_out_1_sel = 0;
+	ax_out_2_pos = 0;
+	ax_out_2_neg = 0;
+	ax_out_2_sel = 0;
+	ax_out_3_pos = 0;
+	ax_out_3_neg = 0;
+	ax_out_3_sel = 0;
+	ax_out_4_pos = 0;
+	ax_out_4_neg = 0;
+	ax_out_4_sel = 0;
+
+	ax_selected_axis = output_button; 	// we have one or it is -1
+	switch (output_button){
+	case 0: {ax_out_0_pos = pos; ax_out_0_neg = neg; ax_out_0_sel = 1;}
+	break;
+	case 1: {ax_out_1_pos = pos; ax_out_1_neg = neg; ax_out_1_sel = 1;}
+	break;
+	case 2: {ax_out_2_pos = pos; ax_out_2_neg = neg; ax_out_2_sel = 1;}
+	break;
+	case 3: {ax_out_3_pos = pos; ax_out_3_neg = neg; ax_out_3_sel = 1;}
+	break;
+	case 4: {ax_out_4_pos = pos; ax_out_4_neg = neg; ax_out_4_sel = 1;}
+	break;
+	default: ;
+	} // set up the direction pins
+	
+	ax_jog_speed = jt_speeds[abs(ring_raw)];
+
+// ==============================================================================================
+// Here we deal with setting up the jog speed table
+// ==============================================================================================
+
+	if ((g_multiplier != last_g_multiplier) || (min_speed != last_min_speed)) { // we need to recalc speed table
+		unsigned table_index;
+		float c_multiplier; // the current multiplier during table build
+
+		c_multiplier = 1.0; 
+
+		for (table_index = 1; table_index < 8; table_index++) { // fill in the speed table
+			jt_speeds [table_index] = min_speed * c_multiplier;
+			c_multiplier = c_multiplier * g_multiplier; // update the multiplier
+		} // end for
+
+		last_min_speed = min_speed; last_g_multiplier = g_multiplier; // remember where we are now
+	} // table recalc
+
+//=====================================================================================================
+// Here we deal with cycling the stepsizes
+//=====================================================================================================
+
+	if (first_call) current_stepsize = smallest_step; // initialise
+
+	if (cycle_stepsizes) {
+		if (!waiting_stepsizes_release) { // we need to do next stepsize
+			step_size_index = gui_step_index;
+			waiting_stepsizes_release = 1; // only do it once per "click"
+			step_size_index++; // move to next index
+			if (step_size_index == number_of_stepsizes) step_size_index = 0; // wrap it
+			current_stepsize = smallest_step; // start size
+			for (iloop = 0; iloop < step_size_index; iloop++)  // do requisite multiply by 10s
+				current_stepsize = current_stepsize * 10.0;
+		}
+
+
+	} else { // input is not set
+		waiting_stepsizes_release = 0;
+		current_stepsize = smallest_step; // start size
+		for (iloop = 0; iloop < gui_step_index; iloop++)  // do requisite multiply by 10s
+			current_stepsize = current_stepsize * 10.0;
+	} 
+	jog_microstep_size = (current_stepsize/g20_scale); // report stepsize to pin
+	shuttle_step_index = step_size_index; // put index out onto pin
+//=======================================================================================================
+
+// Been here once
+	first_call = 0;
+	
+ } // main function
-- 
1.7.0.4

