O1 sub
(print,Switching to tool #1)
T[#1] M6    ; Select pocket & change tool
(print,)
O1 endsub

O2 sub
(print,Applying tool #1)
M61 Q[#1]   ; Change tool
G43 H[#1]   ; Apply TLO
(print,)
O2 endsub
