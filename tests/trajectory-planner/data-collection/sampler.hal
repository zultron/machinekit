# Sampler config

loadrt sampler depth=1600 cfg=ffffffu

addf sampler.0              servo-thread

# KLUDGE workaround for the hypothesized extra timestep lag in sim config
setp motion.debug-gain-0 1.0

net Xpos => sampler.0.pin.0
net Ypos => sampler.0.pin.1
net Zpos => sampler.0.pin.2
net spindle-velocity-measured_rps => sampler.0.pin.3
net RequestedVel motion.current-vel => sampler.0.pin.4
net LastPeriod motion.last-period-ns => sampler.0.pin.5
net SegmentID motion.program-line => sampler.0.pin.6
