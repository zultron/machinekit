#!/usr/bin/env python 

import sys
import os
import glob
import subprocess
import shutil


def find_test_cases():
    return glob.glob('nc_files/*.ngc')


if __name__ == '__main__':

    # Get a list of all the file paths that ends with .txt from in specified directory
    for f in glob.glob('stdout_*.log'):
        os.remove(f)

    for f in glob.glob('stdout_*.log.txt'):
        os.remove(f)

    for t in find_test_cases():
        print >>sys.stderr, "Running test case", t
        with open(os.path.join(os.path.dirname(t),'stdout_' + os.path.basename(t) + '.log'), 'w') as f_out:
            f_out.write('{{start_collection: "{}"}}\n'.format(t))
            shutil.copyfile('position.blank','position.txt')
            p = subprocess.Popen(['linuxcnc', '-r', 'data-collection.ini', t], stdout=f_out)
            p.wait()
            f_out.write('{{end_collection: "{}"}}\n'.format(t))
        if p.returncode != 0:
            sys.exit(p.returncode)
