#!/usr/bin/env python 

import sys
import os
import subprocess


def check_results(raw_output, dest_file):
    with open(dest_file,'w') as r:

        if not os.path.exists(raw_output):
            r.write('Failed: no test output found\n')
            return -1

        failure_count = 0
        results=[]
        with open('stderr') as f:
            for l in f.readlines():
                for s in ("Passed", "Test"):
                    if s in l:
                        results.append(l)

                if "Failed" in l:
                    failure_count += 1
                    results.append(l)

        r.writelines(results)
        return failure_count


if __name__ == '__main__':
    sys.exit(check_results('stderr', 'test_results'))

