#!/usr/bin/env python 

import sys
import os
import subprocess


def check_results(raw_output, dest_file):
    results=[]
    if not os.path.exists(raw_output):
        results.append('Failed: no test output found in file %s\n' % raw_output)

    else:
        failure_count = 0
        results=[]
        with open(raw_output) as f:
            for l in f.readlines():
                for s in ("Passed", "Test"):
                    if s in l:
                        results.append(l)

                if "Failed" in l:
                    failure_count += 1
                    results.append(l)

    with open(dest_file,'w') as r:
        r.writelines(results)
    for row in results:
        if "failed" in row:
            print row

    return failure_count


if __name__ == '__main__':
    out_name = (sys.argv[1] if len(sys.argv) > 1 else None) or './test_results'
    out_dir = os.path.dirname(out_name)
    err_count = check_results(os.path.join(out_dir,'stderr'), out_name)
    sys.exit(err_count)

