# Sampler config

loadrt sampler depth=1600 cfg=fffffsb

addf sampler.0              servo-thread

# KLUDGE workaround for the hypothesized extra timestep lag in sim config
setp motion.debug-gain-0 2.0

net spindle-position-measured => sampler.0.pin.0
net spindle-velocity-measured_rps => sampler.0.pin.1
net Zvel => sampler.0.pin.2
net Zpos => sampler.0.pin.3
net pos-tracking-error motion.pos-tracking-error => sampler.0.pin.4
net pos-tracking-state motion.pos-tracking-state => sampler.0.pin.5
net spindle-index-enable sampler.0.pin.6
