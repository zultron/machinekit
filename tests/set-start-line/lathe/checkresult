#!/usr/bin/env python

import json
import difflib
import sys
import os


def check_file_contents(t_name, t_path):
    if t_name is None:
        print("Failed to find test file name", file=sys.stderr)
        return False
    expected_logfile = '{}_from_start.log'.format(t_name)
    got_logfile = '{}_from_line.log'.format(t_name)
    print("Comparing {} and {}".format(expected_logfile, got_logfile), file=sys.stderr)
    with open(os.path.join(t_path, expected_logfile),'r') as f_start:
        s1 = f_start.readlines()
        if not s1:
            print("No modal state data found for {}".format(expected_logfile), file=sys.stderr)
            return False
        with open(os.path.join(t_path, got_logfile),'r') as f_line:
            s2 = f_line.readlines()
            if not s2:
                print("No modal state data found for {}".format(got_logfile), file=sys.stderr)
                return False
            d=list(difflib.unified_diff(s1,s2))
            if d:
                print("Failed: Found differences between modal state")
                for l in d:
                    print(l.rstrip(), file=sys.stderr)
                return False
            print("Passed: contents identical")
    return True

if __name__ == '__main__':
    out_name = (sys.argv[1] if len(sys.argv) > 1 else None) or './test_results'
    out_dir = os.path.dirname(out_name)
    with open(os.path.join(out_dir, 'tests.json'),'r') as f:
        tests=json.load(f)

    exit_code=0
    for t in tests.get('tests',[]):
        t_name = t.get("file",None)
        if not check_file_contents(t_name, out_dir):
            exit_code = 1


    sys.exit(exit_code)

