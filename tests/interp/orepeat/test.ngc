G90 G20 G54
G0 X0 Y0 Z0

; Increment move
o<function1> sub
G91 G1 X0.01 F123
G90
o<function1> endsub

; return a value via return
o<function2> sub
G91 G1 Y0.01 F456
G90
o<function2> endsub

; a procedure without return value
o<proc> sub
o<proc> endsub

