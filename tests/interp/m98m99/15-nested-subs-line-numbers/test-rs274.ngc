%
( A nested rs274ngc subroutine example )

#1 = 0
(PRINT,X MAIN BEGIN LINE #<_line> [exp. 5]:  1=#1)
G91 G0 X0.1 ; generate state tag
O2 CALL
G91 G0 X0.1 ; generate state tag
(PRINT,X MAIN END LINE #<_line> [exp. 9]:  1=#1)
M30

O2 SUB
G91 G0 X0.1 ; generate state tag
(PRINT,X O2 BEGIN LINE #<_line> [exp. 14]:  1=#1)
O1 CALL
#1 = [FIX[#1] + 1]
(PRINT,X O2 END LINE #<_line> [exp. 17]:  1=#1)
G91 G0 X0.1 ; generate state tag
O2 ENDSUB

O1 SUB
G91 G0 X0.1 ; generate state tag
#1 = [#1 + 0.1]
(PRINT,X >>>> LOOP [O2.O1] LINE #<_line> [exp. 24]:  #1)
G91 G0 X0.1 ; generate state tag
O1 ENDSUB
%
