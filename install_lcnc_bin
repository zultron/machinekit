#echo "lathe config dir is: $BASE_LATHE_CONFIG"
#BASE_MILL_CONFIG=$USER_HOME"/linuxcnc/configs/tormach_mill"
#mkdir -p $BASE_MILL_CONFIG
#echo "lathe config dir is: $BASE_MILL_CONFIG"



# we only want a few things from bin
LCNC_BIN_FILES="
linuxcncsvr
halcmd
halui
inivar
io
milltask
shuttlexpress
redis-server
"

LCNC_LIB_FILES="
python/gremlin.py
python/hal.py
python/_hal.so
python/hershey.py
python/linuxcnc.so
python/gcode.so
python/glnav.py
python/minigl.so
python/_togl.so
"

LCNC_RTLIB_FILES="
abs.ko
constant.ko
debounce.ko
encoder.ko
estop_latch.ko
gearchange.ko
hal_lib.ko
hal_parport.ko
hm2_pci.ko
hostmot2.ko
