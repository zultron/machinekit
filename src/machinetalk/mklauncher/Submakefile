MKWDIR := machinetalk/mklauncher

MKLAUNCHER_COMP_PY = mklauncher

$(patsubst %, ../bin/%, $(MKLAUNCHER_COMP_PY)) : ../bin/%: $(MKWDIR)/%.py
	@$(ECHO) Syntax checking python script $(notdir $@)
	$(Q)$(PYTHON) -c 'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")' $<
	$(ECHO) Copying python script $(notdir $@)
	cp $< $@
	chmod +x $@

PYTARGETS += $(patsubst %, ../bin/%, $(MKLAUNCHER_COMP_PY))

