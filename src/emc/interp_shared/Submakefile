INCLUDES += emc/interp_shared

# No source files, interp_shared is header-only

$(patsubst ./emc/interp_shared/%,../include/%,$(wildcard ./emc/interp_shared/*.h)): ../include/%.h: ./emc/interp_shared/%.h
	cp $^ $@

$(patsubst ./emc/interp_shared/%,../include/%,$(wildcard ./emc/interp_shared/*.hh)): ../include/%.hh: ./emc/interp_shared/%.hh
	cp $^ $@
