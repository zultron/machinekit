INCLUDES += emc/interp_shared

LIB_SRCS := \
    emc/interp_shared/StateTag.cc \
    emc/interp_shared/positionarray.cc \
    emc/interp_shared/coordinatetransform.cc \

USERSRCS += $(LIB_SRCS)

$(call TOOBJSDEPS, $(LIB_SRCS)) : EXTRAFLAGS=-fPIC

TARGETS += ../lib/libinterp_shared.a

../lib/libinterp_shared.a: $(call TOOBJS,$(LIB_SRCS))
	$(ECHO) Linking $(notdir $@)
	@mkdir -p ../lib
	@rm -f $@
	@$(AR) $(ARFLAGS) $@ $^

$(patsubst ./emc/interp_shared/%,../include/%,$(wildcard ./emc/interp_shared/*.h)): ../include/%.h: ./emc/interp_shared/%.h
	cp $^ $@

$(patsubst ./emc/interp_shared/%,../include/%,$(wildcard ./emc/interp_shared/*.hh)): ../include/%.hh: ./emc/interp_shared/%.hh
	cp $^ $@
