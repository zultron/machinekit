component home2nstop "HAL component for homing clear path motors using hard stop or limit switches and other axis motor functions ";

license "GPL";
author "Tormach";

// CPM = ClearPath Motor 

// Inputs:
// bit      limit-in                from machine axis limit switch
// s32      home-state              from axis.N.home-state
// bit      limit-enable            from UI setting
// float    joint-pos-fb            from axis.N.joint-pos-fb
// bit	    hlfb		    from "High Level Feed Back" of CPM
// bit      index-count 	    SLP not used, remove it

// Params:
//          latch-vel               units/s - used for travel direction
//          limit-backoff           SLP not used, remove it.  units to continue off limit before index search
//          limit-index-min         SLP not used, remove it.  units minimum distance between switch and index

// Outputs:
// bit      limit-out               to axis.N.home/neg/pos-lim-sw-in
// bit      motor-enable-out        to Clear Path Motor enable
// bit 	    motor-fault		    to axis.N.amp-fault-in
// s32      motor-state             state of this CPM motor component
// s32      internal-status-code        used as internal status-code.  The other status-code is read/write and is constantly reset to 0 by UI
// bit      brake-release           connected to axis (Z) brake

// Bi-directional Input & Output
// s32      motor-command           commands from PP UI/Python to this CPM linuxcnc component
// s32      status-code             status and error code to UI. It is roughly is HLFB from CPM, but includes other command error feedback
// float    limit-index-distance    //SLP not used, remove it at some point

// input pins

// from counter connected to encoder index
pin in s32 index-count;

// physical limit switch input
pin in bit limit-in;

// current home state from axis.N.home-state
pin in s32 home-state;

// UI setting for enabling limit switches
pin in bit limit-enable;

// setting from UI enabling and setting ClearPath Motor Mode
pin io s32 motor-command;


// High Level Feed Back (hlfb) from ClearPath Motor
pin in bit hlfb;

// from motion axis.N.joint-pos-fb
pin in float joint-pos-fb;

// outputs
pin out bit brake-release;   

// what we tell motion axis.N the limit state is
pin out bit limit-out;

// hardware to enable ClearPath motor
pin out bit motor-enable-out;

pin out bit motor-fault;

// Bi-directional I/O

// let UI clear it after reading SLP I'm not using bi-directional ability of this pin 
pin io s32 status-code;

// tell the UI distance between switch inactive and index
// let UI clear it after reading
pin io float limit-index-distance;

pin out s32 motor-state;
pin out bit fake-open; //flag to lie to linuxcnc we're off of limit switch when we're not.
//needed while we are doing hardstop homing 

// params

// index closer to switch than this results in error_code ERROR_INDEX_TOO_CLOSE_TO_SWITCH
param rw float limit-index-min;  //set to .030 in ecm1.hal

// used for sense of direction on backoff and index search
param rw float latch-vel;

// distance to move off limit before index search to avoid switch inconsistency
param rw float limit-backoff; //set to .020 in ecm1.hal

// distance to go after limit backoff to search for index
// greater than this results in error_code ERROR_INDEX_SEARCH_TIMEOUT
param rw float index-search-max; //set to .220 in ecm1.hal

// must be a pin to compare with limit-in, bool quietly does not work
pin io bit prev-limit-in;

// as pins for debugging visibility
pin io s32 prev-index-count;
pin io float limit-fall-pos;
pin io float index-active-pos;
pin io float backoff-pos;
pin io float index-search-max-pos;
pin out float position-at-hstop;
pin out float position-at-fall-search-start;
pin out float position-at-fall;
pin out s32 home-state-out;
pin out s32 delay-state;
pin out s32 hit-hardstop;
pin out s32 target-command;
pin out s32 internal-status-code;

// used with fperiod macro provided by comp processor to compute delays
pin out float elapsed-timer;  // CPM enable pulse timing, and position verses HLFB error timer

function _;

;;

#include <math.h>

#define BIT_FALSE 0
#define BIT_TRUE  1

#define BRAKE_RELEASE 1
#define BRAKE_HOLD    0

//########## keep these in sync with constants.py!!
//Previous error codes for LeadShine drivers
#define HLFB_OK                         0   //was "ERROR_NONE" No Error. This CPM component understood and acted on last command and so far has no error executing it.
#define HLFB_INDEX_TOO_CLOSE_TO_SWITCH  1
#define HLFB_INDEX_SEARCH_TIMEOUT       2
//CPM Error codes, other motor comps won't use (HLFB_FAULT may be exception)
#define HLFB_CMD_INVALID                3    //unexpected command, i.e. comp is in invalid state to accept it now ; we ignored it
#define HLFB_POSITION                   4    //axis motor reported temporary position error. PP UI is expected to clear this error with MOTOR_CMD_ACK_POS command
#define HLFB_CMD_UNKNOWN                5    //unknown command; we ignored it
#define HLFB_FAULT                      6    //axis motor has faulted.  Could be a fault or no power on CPM.  We don't know

//CPM linuxcnc States
#define MS_DISABLED         0    //CPM has been commanded disabled
#define MS_WAIT             1    //This linuxcnc component is initializing CPM; please wait 
#define MS_HSTOP_SEARCHING  2    //This linuxcnc component is expecting PP UI to be executing homing; we haven't detected a hardstop hit yet
#define MS_HSTOP_WAITING    3    //This linuxcnc component detected a hardstop hit, but we wait to let CPM motors complete that detection, or to fail with HLFB un-asserted
#define MS_HSTOP_HIT        4    //The CPM has detected a hardstop hit. We expect Linuxcnc is still finishing backoff, ect.
#define MS_NORMAL           5    //CPM is active and is not in any hardstop mode 
#define MS_FAULT            6    //CPM is inactive. We've detected a fault or via ESTOP has been powered off, this comp can't really tell. (but UI can infer)

//Commands to this linuxcnc component
#define MOTOR_CMD_NONE      0    //there is no command, or cleared/did/acknowledge last command.  We use this on the bi-directional i/o to "edge detect" commands and signal to UI, if it cares to look (it doesn't presently)
#define MOTOR_CMD_DISABLE   1    //Disable CPM.  The enable line to the CPM is immediately de-asserted so it will no longer move or actively hold position
#define MOTOR_CMD_NORMAL    2    //Enable the CPM for normal operation.  This comp assumes that PP UI issues the requisite minimum 1 step in each direction to disable hardstop homing mode
                                 //This comp passes through "MS_WAIT" state before assuming "MS_NORMAL" state
#define MOTOR_CMD_HARDSTOP  3    //Enable the CPM for hardstop detection.  After "MS_WAIT", we enter "MS_HSTOP_SEARCHING" state. 
                                 //Then this comp assumes PP will issue homing commands to linuxcnc.  The first CPM HLFB inactive state triggers "MS_HSTOP_HIT"
#define MOTOR_CMD_ACK_HSTOP 4    //When homing is finished, use this command to transistion from "MS_HSTOP_HIT" to "MS_NORMAL" without toggling CPM enable which would have put CPM back into torque foldback mode
#define MOTOR_CMD_ACK_POS   5    //UI uses this command to acknowledge temporary HLFB_POSITION "errors".  This comp will clear error to HLFB_OK and doesn't change motor state
#define MOTOR_CMD_ACK_ERR   6    //UI use this command to acknowlege all other error.  This comp will clear previous UI command errors to HLFB_OK if CPM hasn't faulted.
//############# end of defines that need to be kept in sync in constants.py 

//The MS_WAIT has 3 delays 
#define DELAY_BRAKE 0  //We're waiting for Z brake to engage or release (done on all axes even though may be no brake)
#define DELAY_OFF   1  //Turn off CPM enable for a while to reset it
#define DELAY_ON    2  //Turn on CPM enable, and wait for it to wake up and assert HLFB 


#define CPM_EN_OFF_DELAY (0.01) //We un-assert enable for this long to reset CPM
#define CPM_EN_ON_DELAY (0.03)  //CPM should respond within this time after we enable it
#define CPM_MAX_POSITION_DELAY (0.120) //If HLFB "error" has been asserted for this long, it's not just a position error
#define CPM_BRAKE_DELAY (.075) //We must wait this long for Z brake to release
#define CPM_HSTOP_SETTLING_DELAY (.25) //We wait this long for CPM to finish it's Hardstop qualification after we've seen HLFB de-assert during MS_HSTOP_SEARCHING

#define HLFB_INACTIVE               0 
#define HLFB_ACTIVE                 1

#define DO_HARDSTOP_HOMING (1)

// copied over from motion.h
// home_state enumerations
#define HOME_FALL_SEARCH_START (13)
#define HOME_FALL_SEARCH_WAIT (14)
#define HOME_IDLE (0)
#define HOME_FINISHED (24)

float fsignof(float fnumber) {
    if (fnumber < 0.0 )
	return -1.0;
    return 1.0;
}

//We are lying to linuxcnc, simply simulating a limit switch.  
//This comp uses states that mention "hard stop" but this comp uses limit switches.  
//This comp is a bridge to using hardstop, so externally we act like we are using CPM's hardstop
//The hitch to getting this to work is that in the PP UI we must issue the "1 step each direction" manuever to 
//have full torque available from the CPM

//So, linuxcnc homing searches for limit switch, hits it, reverses or backs off 'till switch releases.  But in our case
//we are lying to linuxcnc saying the limit switch release didn't happen until we see the "right" z index pulse
//we then let linuxcnc know the limit switch released.  By "right", we mean we don't want one too close or too far from the real limit switch
//release. 

//The above describes the operation with LeadShine hardware.  With ClearPath hardware, we don't have the index Z pulse.  
//CPM - clear path motor  HLFB - High Level Feed Back from CPM
//The HLFB has serves dual purposes.  1) detecting the "fault" when homing and 2) normal "fault" detection when not homing
//There is no need to move away from limit (home) switch looking for the release.  In fact, ANY movement at LATCHVEL by
//linuxcnc just adds error to the hard stop detection.  (The primary error is the delta time between the CPM's hard stop detection and when 
//linuxcnc sees it.  At .75 IPS SEARCHVEL, and assuming worst case 2mS latency, we move .00075 inches... we may want to double home?? from 
//PP layer??
//We completely ignore home/limit switches and simulate them to linuxcnc.  We signal linuxcnc the hardstop happened by monitoring HLFB, 
//then actuate the simulated switch.  We know that linuxcnc has seen this actuation by change of state to HOME_FALL_SEARCH_START, when
//we say switch un-actuated again to linuxcnc.

FUNCTION(_) {


    brake_release = BRAKE_HOLD;

//######### Handle new motor commands first.  Perhaps set some new states and conditions 

    if (motor_command != MOTOR_CMD_NONE) {

        if (motor_command == MOTOR_CMD_DISABLE) {
            brake_release = BRAKE_HOLD;
            motor_state = MS_WAIT;
            delay_state = DELAY_BRAKE;
            elapsed_timer = 0.0;
            status_code = HLFB_OK;
            internal_status_code = HLFB_OK;
            target_command = motor_command; //keep last command for later state change use
        }
        else if (motor_command == MOTOR_CMD_NORMAL || motor_command == MOTOR_CMD_HARDSTOP) {
            hit_hardstop = FALSE;
            delay_state = DELAY_BRAKE;
            motor_state = MS_WAIT;
            elapsed_timer = 0.0;
            status_code = HLFB_OK;
            internal_status_code = HLFB_OK;
            target_command = motor_command; //keep last command for later state change use
            brake_release = BRAKE_HOLD;
            fake_open = FALSE;
            position_at_hstop = 99999.0;
            position_at_fall_search_start = 99999.0;
            position_at_fall = 99999.0;
        }
        else if (motor_command == MOTOR_CMD_ACK_HSTOP) {
            if (motor_state == MS_HSTOP_HIT) {
                motor_state = MS_NORMAL;
                status_code = HLFB_OK;
                internal_status_code = HLFB_OK;
            }//else don't change motor_state and flag UI it's doing something wrong
            else {
                if (internal_status_code != HLFB_FAULT) { //never clear a HLFB_FAULT this way (use MOTOR_CMD_NORMAL or MOTOR_CMD_HARDSTOP) 
                    status_code = HLFB_CMD_INVALID;
                }
            }
        }
        else if (motor_command == MOTOR_CMD_ACK_POS) {
            if (motor_state == MS_NORMAL && internal_status_code == HLFB_POSITION) {
                status_code = HLFB_OK;
                internal_status_code = HLFB_OK;
            {
            else if (motor_state != MS_FAULT)
                status_code = HLFB_CMD_INVALID; //clue UI it's lost.
                //DON'T set internal_status_code 
        }
        else if (motor_command == MOTOR_CMD_ACK_ERR) {
            if(motor_state != MS_FAULT)
                status_code = HLFB_OK;
                //DON'T change internal_status_code
        }
        else { //unknown command
            status_code = HLFB_CMD_UNKNOWN;
            //DON'T change internal_status_code
        }
        motor_command = MOTOR_CMD_NONE; //flag UI and use as "edge detect" so we do this only once for each UI request
    }

//########## Handle CPM motor states here 

    if (motor_state == MS_DISABLED) { 
        motor_enable_out = FALSE; //disable CPM
        status_code = HLFB_OK;
        internal_status_code = HLFB_OK;
        motor_fault = TRUE; //flag HAL axis-fault-in
        brake_release = BRAKE_HOLD;
    }
    else if (motor_state == MS_WAIT) {
        brake_release = BRAKE_HOLD;
        motor_fault = FALSE; //flag HAL axis-fault-in
        elapsed_timer += fperiod;

        if (delay_state == DELAY_BRAKE) {
            if (elapsed_timer > CPM_BRAKE_DELAY) {
                elapsed_timer = 0.0;
                delay_state = DELAY_OFF; 
                motor_enable_out = FALSE; //toggle enable
                if (target_command == MOTOR_CMD_DISABLE) {
                    motor_state = MS_DISABLED;
                    motor_enable_out = FALSE;
                    status_code = HLFB_OK;
                    internal_status_code = HLFB_OK;
                    motor_fault = TRUE;
                    brake_release = BRAKE_HOLD;
                }
            }
        }
        else if (delay_state == DELAY_OFF) {
            if (elapsed_timer > CPM_EN_OFF_DELAY) {
                elapsed_timer = 0.0; 
                delay_state = DELAY_ON;
                motor_enable_out = TRUE; //enable CPM
            }
        }
        else if (delay_state == DELAY_ON) {
            if (elapsed_timer > CPM_EN_ON_DELAY || hlfb == HLFB_ACTIVE) {
                if (hlfb == HLFB_ACTIVE) { //CPM has responded
                    if (target_command == MOTOR_CMD_HARDSTOP) {
                        motor_state = MS_HSTOP_SEARCHING;
                        elapsed_timer = 0.0;
                        brake_release = BRAKE_RELEASE;
                    }
                    else if (target_command == MOTOR_CMD_NORMAL) {
                        motor_state = MS_NORMAL;
                        elapsed_timer = 0.0;
                        brake_release = BRAKE_RELEASE;
                    }
                }
                else {
                    motor_state = MS_FAULT;
                    status_code = HLFB_FAULT;
                    internal_status_code = HLFB_FAULT;
                    motor_enable_out = FALSE;
                    motor_fault = TRUE; //flag HAL axis-fault-in 
                    brake_release = BRAKE_HOLD;
                }
            }
        }
    }
    else if (motor_state == MS_HSTOP_SEARCHING) {
        brake_release = BRAKE_RELEASE;
        //there is no timeout here.  We assume PP and/or linuxcnc gives up seeking home
        motor_fault = FALSE; //flag to HAL axis-fault-in
#if (DO_HARDSTOP_HOMING) //this is code for when we want actual hard stop homing
        if (hlfb == HLFB_INACTIVE) { //did we hit hard stop??
            motor_state = MS_HSTOP_WAITING;
#else // this is code for using limit switches to fake hardstop homing
        if (limit_in == TRUE) {//limit switch is active, pretend we hit hardstop
            motor_state = MS_HSTOP_HIT; //skip MS_HSTOP_WAITING mode as we'd have problems riding up on limit switch if we wait to stop!!
            hit_hardstop = TRUE;  //flag for below code that deals with linuxcnc homing
#endif
            elapsed_timer = 0.0; //HLFB from CPM can't stay inactive for too long, so start timer
        }
    }
    else if (motor_state == MS_HSTOP_WAITING) {
        elapsed_timer += fperiod;
        if(elapsed_timer > CPM_HSTOP_SETTLING_DELAY) { //we waited long enough to check HLFB again
            if (hlfb == HLFB_ACTIVE) { //SLP we need to check this more than once
                motor_state = MS_HSTOP_HIT;
                hit_hardstop = TRUE;  //flag for below code that deals with linuxcnc homing
                elapsed_timer = 0.0; //HLFB from CPM can't stay inactive for too long, so start timer
        }
    }

    }
    else if (motor_state == MS_HSTOP_HIT) {
        //we exit this mode if 1) the CPM HLFB fails for too long or 2) 
        brake_release = BRAKE_RELEASE;
        //we still monitor HLFB here for abnormal periods of in-activity, even when simulating hardstop homing with switches
        //incase CPM goes south
        motor_fault = FALSE; //flag HAL axis-fault-in
        if (hlfb == HLFB_INACTIVE) {
            elapsed_timer += fperiod;
            if (elapsed_timer > CPM_MAX_POSITION_DELAY) {
                motor_fault = TRUE; //flag HAL axis-fault-in
                status_code = HLFB_FAULT;
                internal_status_code = HLFB_FAULT;
                motor_state = MS_FAULT;
                motor_enable_out = FALSE;
                brake_release = BRAKE_HOLD;
            }
        }
        else elapsed_timer = 0.0; //active CPM HLFB, so reset time-out timer
    }
    else if (motor_state == MS_NORMAL) {
        brake_release = BRAKE_RELEASE;
        motor_fault = FALSE; //flag HAL axis-fault-in
        if (hlfb == HLFB_INACTIVE) {
            elapsed_timer += fperiod;
            if (elapsed_timer > CPM_MAX_POSITION_DELAY) {
                motor_fault = TRUE; //flag HAL axis-fault-in
                motor_state = MS_FAULT;
                status_code = HLFB_FAULT;
                internal_status_code = HLFB_FAULT;
                motor_enable_out = FALSE;
                brake_release = BRAKE_HOLD;
            }
        }
        else elapsed_timer = 0.0;
    }
//    else if (motor_state == MS_FAULT) //do same thing for MS_FAULT or unknown state
    else { //impossible motor_state
        motor_state = MS_FAULT;
        status_code = HLFB_FAULT;
        internal_status_code = HLFB_FAULT;
        motor_enable_out = FALSE;
        motor_fault = TRUE; //flag HAL axis-fault-in
        brake_release = BRAKE_HOLD;
    }

// ##########  Now resolve homing and linuxcnc states;  We've resolved CPM motor states above
// #########  and really the only variable we care about from above is if we've hit the hardstop or limit switch or not
    
    home_state_out = home_state;

    if (!limit_enable) {
        // do not report limit switch activity if settings have them disabled
        limit_out = FALSE;  //FALSE = limit not actuated (switch N.C.) 
    }
    else if (home_state == HOME_IDLE) {
        limit_out = limit_in; //report true state of limit switch
    }
    else if (home_state < HOME_FALL_SEARCH_START) { //linuxcnc homing is searching for limit switch at SEARCHVEL velocity
        if (hit_hardstop) {
            limit_out = TRUE; //tell linuxcnc we hit limit switch
            hit_hardstop = FALSE; //reset flag so we don't reuse it
        }
        position_at_hstop = joint_pos_fb;  //linuxcnc will put HOME_OFFSET here
        //backoff_pos = fsignof(latch_vel) * .1; //should move us off limit switch (needed .53 on y)
    }
    else if (home_state == HOME_FALL_SEARCH_START) { //linuxcnc saw homing (limit) switch actuated, reversed dir and is moving off limit switch at LATCHVEL
        position_at_fall_search_start = joint_pos_fb;
        backoff_pos = joint_pos_fb + (fsignof(latch_vel) * .1); //move .1" from Hard stop.  Linuxcnc will again put HOME_OFFSET here
        limit_out = TRUE; //we can't lie 'till next linuxcnc state we fell off limit switch; is any movement here is an issue to destroy hardstop location detection??!! 
    }
    else if (home_state == HOME_FALL_SEARCH_WAIT) { 
#if (DO_HARDSTOP_HOMING)
	//have we moved far enough yet? for 
        if ((latch_vel >= 0.0 && joint_pos_fb >= backoff_pos) || (latch_vel <  0.0 && joint_pos_fb <= backoff_pos)) {
            limit_out = FALSE;
            fake_open = TRUE; //continue lie we're off limit switch until we don't have to lie 
            motor_state = MS_NORMAL; //we exit "MS_HSTOP_HIT" state  
            position_at_fall = joint_pos_fb;
        }
#else
        limit_out = limit_in; //pass through true state of limit switch
        if(limit_out == FALSE)
            motor_state = MS_NORMAL;  //we exit "MS_HSTOP_HIT" state
#endif
    }
//    keep reporting whatever limit_out was before if we don't know state of homing
    else { //home_stat something else, report limit actual switches
        if(fake_open){
            limit_out = FALSE; // lie until we actually move off of limit switch
            if(limit_in == FALSE) //clear this state once we actually move off of the limit switch
                fake_open = FALSE;
        }
        else 
            limit_out = limit_in; 
    }

//SLP WARNING SLP remove this next line!!!
    motor_fault = FALSE;

    if(motor_enable_out == FALSE)
        brake_release = BRAKE_HOLD;

}


