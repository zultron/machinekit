#include <rtapi_math.h>
/* 
Scheme is for STEP_TIME worth of SYNC "Pulse" from 24R I/O expansion board
Then another STEP_TIME worth of Data from 24 I/O expansion board
Then another STEP_TIME "STOP" pulse from 24 I/O expansion board.

if STEP_TIME = 33 ms, then full cycle of SYND, DATA, STOP takes 99 ms or just under 100ms or 1/10 sec of delay

*/

//KEEP IN SYNC with PIC on 24R!   Both ends must be in agreement for what the freqs mean!

//Feedback from the 24R spindle to PP
//feedback value (fb_value) is result of OR'ing all active possible input bits together, and shoving that value into a PIC register.
//The resultant freq is 1/(8uS * (fb_value + 1))
#define PIC_CCP_CLOCK_RATE (8.0)

//U08 fb_value;

#define BMASK_BUTTON (0x1)
#define BMASK_PDB    (0x2)
#define BMASK_TOOL   (0x4)
#define BMASK_ALLOWED (0x8)
#define BMASK_FB_MAX (15.0) //(0xF) //value if all fb BMASKs are high
//from the above fb BMASKs, the un-offsetted fb_value ranges 0x to 0xF

//we avoid the lowest feedback values, which generate the highest freq output from PIC, yet do not electrically make it through the feedback OPTOs.
#define FB_OFFSET  (4.0)   //means the min fb_value is FB_OFFSET and the highest freq from PIC is 1/(PIC_CCP_CLOCK_RATE * (fb_value + 1)) = 1/(8uS * (FB_OFFSET + 1)) = 1/(8us * (4 + 1)) = 25kHz
#define FB_MAX  (FB_OFFSET + BMASK_FB_MAX) //max fb_value = BMASK_FB_MAX + FB_OFFSET = 15 + 4 = 19 = 0x12 => 1/(PIC_CCP_CLOCK_RATE * (fb_value + 1)) = 1/(8us * (19 + 1)) = 6250 Hz generated from PIC

#define STEP_PERIOD (8.0) //uS is resolution of CCP2 generator on the PIC


/* The PIC is using the internal RC clock which is +/- 1% and isn't accurate enough.  Therefore, the PIC will send it's max freq for 33 mS, the current "data" feedback for 33 mS, and the min freq for 33 mS.  
We use the linear point slope formula to calibrate PP to the PIC on each data value.
slope = (y2 - y1)/(x2 - x1), where x1 is FB_MAX, x2 is FB_OFFSET (aka "MIN"), y1 is min freq (stop), and y2 is max freq (sync)
Xdata = fb_value sent by PIC
Ydata = PIC freq RX'd 
calculate the actual fb_value from the PIC with Xdata = int(.5 + FB_MAX - ((Ydata - y2)/slope) - FB_OFFSET))
*/

unsigned int _decodePicFB(struct __comp_state const *__comp_inst, float freq_in)  //convert raw PIC data freq into a bit mask feedback value
{
int fb_value = 0;
//float slope, fb_read;
    sync_period = 1000000.0/sync;
    stop_period = 1000000.0/stop;
    this_period = 1000000.0/fabs(freq_in);

    slope = (sync_period - stop_period)/(FB_OFFSET - FB_MAX);
    
    fb_read = FB_MAX - ((this_period - sync_period)/slope) - FB_OFFSET;

    if (fb_read < -0.0001 || (fb_read > (FB_MAX + .0001))) {
        fb_read_error++;
        fb_bad = fb_read;
    }

    fb_value = BMASK_FB_MAX - (int)(fb_read + 0.5);

    return fb_value;
}

void _demuxPicFB(struct __comp_state const *__comp_inst, unsigned int new_fb_value)
{

    if (new_fb_value & BMASK_BUTTON)
        user_sense = TRUE;
    else user_sense = FALSE;

    if (new_fb_value & BMASK_PDB)
        pdb_sense = TRUE;
    else user_sense = FALSE;

    if (new_fb_value & BMASK_TOOL)
        tool_sense = TRUE;
    else tool_sense = FALSE;

    if (new_fb_value & BMASK_ALLOWED)
        fb_user_pdb_allowed = TRUE;
    else fb_user_pdb_allowed = FALSE;

}

