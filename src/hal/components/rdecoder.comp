//macro'tized all these calls so we can forget about the comp_state pointer
#define decodePicFB(our_value) (_decodePicFB(__comp_inst, our_value))
#define demuxPicFB(our_value) (_demuxPicFB(__comp_inst, our_value))
//#define gemerate() (_generate(__comp_inst, our_value))

#define MISSING_IO_TIME_OUT (500)

#define PIC_X_TO_FREQ(x) (1.0/((PIC_CCP_CLOCK_RATE/1000000.0) * (x + 1)))

#define PIC_MAX_FB_FREQ (PIC_X_TO_FREQ(FB_OFFSET)) //25kHz
#define PIC_MAX_FB_FREQ_DOWN_1_STEP ((PIC_X_TO_FREQ(FB_OFFSET)+PIC_X_TO_FREQ(FB_OFFSET+1))/2) // ((25kHz + 12.5kHz)/2) = 18.75 kHz
#define PIC_MIN_FB_FREQ (PIC_X_TO_FREQ(FB_MAX)) //6250kHz 

#define PIC_TOLERANCE (10.0) //we assume PIC can keep within 10%

#define SYNC_FREQ_DETECT  (PIC_MAX_FB_FREQ_DOWN_1_STEP) // (25 kHz + 12.5 kHz)/2 = 18.75 kHz

#define STEP_TIME (.033)  //this is period 24R input mux routine is using
#define STEP_EDGE_DELTA (.005) //reset average STEP_EDGE_DELTA from STEP_TIME start, the read average at STEP_EDGE_DELTA from end

//all of these will be increasing in time
#define STEP_SYNC_AVE_RESET (STEP_EDGE_DELTA) //5ms
#define STEP_SYNC_SAMPLE_TIME (STEP_TIME - STEP_EDGE_DELTA) //27ms
#define STEP_DATA_AVE_RESET (STEP_TIME + STEP_EDGE_DELTA) //38 ms
#define STEP_DATA_SAMPLE_TIME ((STEP_TIME * 2) - STEP_EDGE_DELTA) //61 ms
#define STEP_STOP_AVE_RESET ((STEP_TIME * 2) + STEP_EDGE_DELTA) //71 ms
#define STEP_STOP_SAMPLE_TIME ((STEP_TIME * 3) - STEP_EDGE_DELTA) //94 ms

#define STATE_START (0) //wait for hit_me to go high
#define STATE_SYNC_BEFORE (1) //look for mux_freq that is below SYNC_FREQ_DETECT
#define STATE_SYNC_EDGE (2) //look for mux_freq that is above SYNC_FREQ_DETECT, then set timer STEP_SYNC_AVE_RESET
#define STATE_SYNC_AVE_RESET (3) //wait for t.o. then reset average and set timer STEP_SYNC_SAMPLE_TIME
#define STATE_SYNC_SAMPLE (4) //wait for t.o. then read sync average and set timer STEP_DATA_AVE_RESET
#define STATE_DATA_AVE_RESET (5) //wait for t.o. then reset ave and set timer STEP_DATA_SAMPLE_TIME
#define STATE_DATA_SAMPLE (6) //wait for t.o. then read data average and set timer STEP_STOP_AVE_RESET
#define STATE_STOP_AVE_RESET (7) //wait for t.o. then reset ave and set timer STEP_STOP_SAMPLE_TIME
#define STATE_STOP_AVERAGE (8) //wait for t.o., then read stop average and set state to STATE_SYNC_BEFORE

#define DATA_CNT (256) 


//Command from PP to 24R spindle
#define BMASK_DUST   (0x1)
#define BMASK_RETURN (0x2)
#define BMASK_BLAST  (0x4)
//see above #define BMASK_ALLOWED (0x8)  
#define BMASK_OPEN   (0x10)

#define PP_MIN_CMD_FREQ (1000.0)
#define PP_MAX_CMD_FREQ (5000.0)
#define PP_CMD_STEPS (32.0)       //2^5, where "5" is # of possiblities

#define PP_MAX_CMD_PERIOD (1.0/PP_MIN_CMD_FREQ)
#define PP_MIN_CMD_PERIOD (1.0/PP_MAX_CMD_FREQ)
#define PP_STEP_CMD_PERIOD ((PP_MAX_CMD_PERIOD - PP_MIN_CMD_PERIOD)/(PP_CMD_STEPS-1))

int passFlag;
unsigned int last_cmd;

void _generate(struct __comp_state const *__comp_inst)
{
static float hi, low;
unsigned int output;

    if (newComp) {
        newComp = 0;

        hi = compHi;
        low = compLow;

        if  (  ((PIC_MAX_FB_FREQ * (1.0 + (PIC_TOLERANCE/100))) > hi)
            && ((PIC_MAX_FB_FREQ * (1.0 - (PIC_TOLERANCE/100))) < hi)
            && ((PIC_MIN_FB_FREQ * (1.0 + (PIC_TOLERANCE/100))) > low)
            && ((PIC_MIN_FB_FREQ * (1.0 - (PIC_TOLERANCE/100))) < low)
            ) {
            comp2 = hi/PIC_MAX_FB_FREQ;
            comp = low/PIC_MIN_FB_FREQ; //lower freq means more cnts, and better resolution?? SLP
        }
    }

    if (dust_shoe_lift) 
        output = BMASK_DUST;
    else output = 0;

    //final, non-prototype, functionality
    if (pdb_return)
        output |= BMASK_RETURN;

    if (air_blast)
        output |= BMASK_BLAST;
    

    if (pdb_open)
        output |= BMASK_OPEN;

    if (user_pdb_allowed)
        output |= BMASK_ALLOWED;

    if (last_cmd != output) {
        pp_to_pic_cmd = output;
//        pp_cmd_freq_no_comp = 1.0 / (PP_MAX_CMD_PERIOD - ((float)(output) * PP_STEP_CMD_PERIOD));
        if (output >= XLAT_STEPS)
            output = 0;
        
        pp_cmd_freq_no_comp = ppCmdXlat[output]; 
        pp_cmd_freq_with_comp = pp_cmd_freq_no_comp * comp;
        if (inputComp < 0.001)
            pp_cmd_freq = pp_cmd_freq_with_comp; //apply auto comp ==> or pp_cmd_freq_no_comp; //apply no inputComp
        else 
            pp_cmd_freq = pp_cmd_freq_no_comp * inputComp;
    }
    
}

#define generate() (_generate(__comp_inst))


FUNCTION(_) { 

    if (!passFlag) {  
        passFlag = 1;
        last_cmd = 0xFFFF; //guaranteed invalid, forces recompute of pp_cmd_freq
        comp = 1.0; //1.0 is no compensation 
        newComp = 0; //don't calc a new compensation
        tolHiHi = PIC_MAX_FB_FREQ * (1.0 + (PIC_TOLERANCE/100));
        tolHiLow = PIC_MAX_FB_FREQ * (1.0 - (PIC_TOLERANCE/100));
        tolLowHi = PIC_MIN_FB_FREQ * (1.0 + (PIC_TOLERANCE/100));
        tolLowLow = PIC_MIN_FB_FREQ * (1.0 - (PIC_TOLERANCE/100));
    }

    timer += fperiod; //bump timer, we don't care if we aren't using it

    switch (state)
    {
    case STATE_START: //wait for hit_me to go high
//        if (hit_me) {
            state = STATE_SYNC_BEFORE;
            freq_ave = 0;
            index = 0;
            trigger = 0;
            timer = 0.0;
            timeout = MISSING_IO_TIME_OUT;
//        }
        break;
    case STATE_SYNC_BEFORE:     //look for mux_freq that is below SYNC_FREQ_DETECT
        if (fabs(mux_freq) < SYNC_FREQ_DETECT) {
            state = STATE_SYNC_EDGE;
            trigger = 0;
        }
        if (timer >= timeout) { //if we don't hear from 24R I/O expansion board
            //SLP missing, so we safe inputs
            compHi = 0.0;
            compLow = 0.0;
        }
        break;
    case STATE_SYNC_EDGE:       //look for mux_freq that is above SYNC_FREQ_DETECT, then set timer STEP_SYNC_AVE_RESET
        if (fabs(mux_freq) > SYNC_FREQ_DETECT) {
            state = STATE_SYNC_AVE_RESET;
            timer = 0.0;
            timeout = STEP_SYNC_AVE_RESET;
            trigger = 1; //let outside world know when we saw trigger
            //hit_me = 0; //allow someone to re start the data collection
        }
        break;
    case STATE_SYNC_AVE_RESET:  //wait for t.o. then reset average and set timer STEP_SYNC_SAMPLE_TIME
        if (timer >= timeout) {
            freq_ave = fabs(mux_freq); //slam present mux_freq to "reset" average
            state = STATE_SYNC_SAMPLE;
            timeout = STEP_SYNC_SAMPLE_TIME;
            trigger = 0;
        }
        break;
    case STATE_SYNC_SAMPLE:     //wait for t.o. then read sync average and set timer STEP_DATA_AVE_RESET
        freq_ave += (fabs(mux_freq) - freq_ave) * .05; //average about 20 samples, so about 20 mS filtering delay
        if (timer >= timeout) { 
            state = STATE_DATA_AVE_RESET;
            timeout = STEP_DATA_AVE_RESET;
            sync = freq_ave;
            trigger = 1;
        }
        break;
    case STATE_DATA_AVE_RESET:  //wait for t.o. then reset ave and set timer STEP_DATA_SAMPLE_TIME
        if (timer >= timeout) {
            freq_ave = fabs(mux_freq); //slam present mux_freq to "reset" average
            state = STATE_DATA_SAMPLE;
            timeout = STEP_DATA_SAMPLE_TIME;
            trigger = 0;
        }
        break;
    case STATE_DATA_SAMPLE:     //wait for t.o. then read data average and set timer STEP_STOP_AVE_RESET
        freq_ave += (fabs(mux_freq) - freq_ave) * .05; //average about 20 samples, so about 20 mS filtering delay
        if (timer >= timeout) {
            state = STATE_STOP_AVE_RESET;
            timeout = STEP_STOP_AVE_RESET;
            detected_freq = freq_ave;
            pic_fb_value = decodePicFB(freq_ave); //convert raw PIC data freq into a bit mask feedback value
            demuxPicFB(pic_fb_value);
            // SLP data(index++) = freq_ave;
            trigger = 1;
        }
        break;
    case STATE_STOP_AVE_RESET:  //wait for t.o. then reset ave and set timer STEP_STOP_SAMPLE_TIME
        if (timer >= timeout) {
            freq_ave = fabs(mux_freq); //slam present mux_freq to "reset" average
            state = STATE_STOP_AVERAGE;
            timeout = STEP_STOP_SAMPLE_TIME;
            trigger = 0;
        }
        break;
    case STATE_STOP_AVERAGE:    //wait for t.o., then read stop average and set state to STATE_SYNC_BEFORE
        freq_ave += (fabs(mux_freq) - freq_ave) * .05; //average about 20 samples, so about 20 mS filtering delay
        if (timer >= timeout) {
            state = STATE_SYNC_BEFORE;
            trigger = 1;
            stop = freq_ave;
            compHi = sync; //save these for PP to 24R I/O PIC compensation
            compLow = stop;
            newComp = TRUE;
            if (index >= (DATA_CNT)) //have we collected all the data values?
                state = STATE_START;    //wait for someone to restart 
        }
        break;
    default: //should never happen!
        state = STATE_SYNC_BEFORE;
        trigger = 0;
        index = 0;
        break;
    }

    generate();

}

