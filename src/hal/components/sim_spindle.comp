component sim_spindle "Simulated spindle with index pulse";

pin in float velocity-cmd "Commanded speed";
pin out float position-fb "Feedback position, in revolutions";
pin out float velocity-fb "Feedback velocity in revolutions";
pin io bit index-enable "Reset \\fBposition-fb\\fP to 0 at the next full rotation";
pin in float time-constant "first-order time constant for spindle response";
param rw float scale = 1.0 
"""factor applied to \\fBvelocity-cmd\\fP.

The result of '\\fBvelocity-cmd\\fP * \\fBscale\\fP' be in revolutions per second.
For example, if \\fBvelocity-cmd\\fP is in revolutions/minute, \\fBscale\\fP should be set to 1/60 or 0.016666667.
""";


license "GPL";

function _;

;;
#include <rtapi_math.h>


FUNCTION(_) {
    const double alpha = fperiod / (time_constant + fperiod);
    double old_position_rev = position_fb;
    double old_velocity_rps = velocity_fb;

    double cmd_velocity_rps = velocity_cmd * scale; // Scale command to internal units
    double cmd_delta = cmd_velocity_rps - old_velocity_rps;

    double new_velocity_rps = cmd_delta * alpha + old_velocity_rps;
    double new_position_rev = old_position_rev + (new_velocity_rps + old_velocity_rps) * fperiod / 2.0;

    if(index_enable && (floor(old_position_rev) != floor(new_position_rev))) {
        index_enable = false;
        if(velocity_cmd < 0)
            new_position_rev -= ceil(new_position_rev);
        else
            new_position_rev -= floor(new_position_rev);
    }
    position_fb = new_position_rev;
    velocity_fb = new_velocity_rps;
}

