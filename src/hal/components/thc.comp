component thc "Torch Height Control";

description 
"""
Torch Height Control
Mesa THC > Encoder > LinuxCNC THC component

The Mesa THC sends a frequency based on the voltage detected to the encoder.
The velocity from the encoder is converted to volts with the velocity scale
parameter inside the THC component.

The THCAD card sends a frequency at 0 volts so the scale offset parameter is
used to zero the calculated voltage.

Component Functions
If enabled and torch is on and X + Y velocity is within tolerance of set speed
allow the THC to offset the Z axis as needed to maintain voltage.

If enabled and torch is off and the Z axis is moving up remove any correction
at a rate not to exceed the rate of movement of the Z axis.

If enabled and torch is off and there is no correction
pass the Z position and feed back untouched.

If not enabled pass the Z position and feed back untouched.

Physical Connections
.br
Plasma Torch Arc Voltage Signal => 6 x 487k 1% resistors => THC Arc Voltage In
.br
THC Frequency Signal => Encoder #0, pin A (Input)
.br
Plasma Torch Arc OK Signal => input pin
.br
output pin => Plasma Torch Start Arc Contacts

HAL Plasma Connections
.br
encoder.nn.velocity => thc.encoder-vel (tip voltage)
.br
motion.spindle-on => output pin (start the arc)
.br
thc.arc-ok <= motion.digital-in-00 <= input pin (arc ok signal)

HAL Motion Connections
.br
thc.requested-vel <= motion.requested-vel
.br
thc.current-vel <= motion.current-vel

""";
 
author "John Thornton";

license "GPLv2 or greater";

option singleton yes;

// Input Pins
pin in float encoder_vel "Connect to hm2_5i20.0.encoder.00.velocity";
pin in float current_vel "Connect to motion.current-vel";
pin in float requested_vel "Connect to motion.requested-vel";
pin in float volts_requested "Tip Volts current_vel >= min_velocityequested (SP)";
pin in float vel_tol "Velocity Tolerance (Corner Lock)";
pin in bit torch_on "Connect to motion.spindle-on";
pin in bit arc_ok "Arc OK from Plasma Torch";
pin in bit enable "Enable the THC, if not enabled Z position is passed through";
//pin in float z_pos_in "Z Motor Position Command in from axis.n.motor-pos-cmd";
pin in float z_vel_in "pid.N.output";
pin in float z_fb_in "stepgen.N.position-fb";
pin in float debug_in;

// Output Pins
pin out float z_pos_out "Z Motor Position Command Out";
pin out float z_fb_out "Z Position Feedback to Axis";
pin out float volts "The Calculated Volts";
pin out bit vel_status "When the THC thinks we are at requested speed";
pin out float z_vel_out "stepgen.N.velocity-cmd";
pin out float debug_z_vel_overide;
pin out float debug_torch_off_ticks;
pin out float debug_torch_on_ticks;
pin out float debug_initial_fb;

// Parameters
param rw float vel_scale "The scale to convert the Velocity signal to Volts";
param rw float scale_offset "The offset of the velocity input at 0 volts";
param rw float velocity_tol "The deviation percent from planned velocity";

//voltage_tol setting ideas
//given range of encoder_vel is ~ 1178 or 9602 counts, that is 8424 counts delta, or about 13 bits.
//we toss the last 3 bits

//a setting of .015 volts is ~ 3 bits  (set in hal.ini file)
// 3 bits is 8 counts, we used a "bit" more, or 10 counts
//derived by using     volts = (encoder_vel - scale_offset) * vel_scale; where scale_offset = -959, and vel_scale = -.00148368
// assume encoder_vel = 2760, volts = -5.51780592
// assume encoder_vel = 2770, volts = -5.53264272
// delta volts = .0148368, set .015 for voltage_tol
param rw float voltage_tol "The deviation of Tip Voltage before correction takes place";
param rw float correction_vel "The amount of change in user units per period to move Z to correct";



// Global Variables
//variable float offset;
variable float last_z_in;
variable float initial_fb;  //this is fb position when arc is commanded on, in present G code .15" height above material
variable int tick_count;
variable int torch_on_ticks;
variable int torch_off_ticks;
variable float z_vel_overide;
variable int torch_on_count;
variable bool velocity_overide_active;

function _;
;;
#include "rtapi_math.h"

FUNCTION(_) {
//default to this; other things below may over-write!!
	z_vel_out = z_vel_in;
	z_fb_out = z_fb_in;
	
	tick_count++;

	if(torch_on) {
		if(torch_on_ticks++ == 0)
			torch_on_count++;
		torch_off_ticks = 0;
//		torch_on_ticks++;
		z_vel_overide = 0;
		velocity_overide_active = false;
	}
	else {
		torch_on_ticks = 0;
		torch_off_ticks++;
	}
	

	if(torch_on_ticks == 1) {
		initial_fb = z_fb_in;
	}

	//magic numbers alert: (for below z_vel_overide) I can't figure out how to declare defines numbers in .comp file
	// the .8 inches is the feed rate observed for my example G code file
	// the .3 is the approx factor for observed z_vel_in of .025.  The thought is to ramp vel to .8, rather than 
	//jump it in one .001 of sec loop
	// .3 * .025 = .0075 per 1/1000 th sec, means .8 is reached in .8/.0075 = 106/1000 or about .1 of a sec


	//if torch_off for more than .1 secs
	// AND we have a z_vel_in command i.e. z position needs to be moved
	// AND requested_vel ~ equals zero i.e. x and y movement has ceased
	if(torch_on_count && !velocity_overide_active && torch_off_ticks > 100 && torch_off_ticks < 200 && ((z_vel_in > .001) || (z_vel_in < -.001))) { // && requested_vel < .00001 && requested_vel > -.00001) {
		velocity_overide_active = true;
		if(z_vel_in < 0) { //if moving negative is required
			z_vel_overide = -.8;
//			if(z_vel_overide > -.8) { //don't exceed .8 inches/sec in negative direction
//				z_vel_overide += z_vel_in * .3;
//			}
		}
		else if (z_vel_in > 0) {
			z_vel_overide = .8;
//			if(z_vel_overide < .8) { //don't exceed .8 inches/sec in positive direction
//				z_vel_overide += z_vel_in * .3;	
//			}
		}
		else  z_vel_overide = 0; 
	}
	//else {
	//	z_vel_overide = 0;
	//}

    //if (z velocity essentially zero), i.e. torch height correct only when very small
    //velocities are requested.
    if (z_vel_in < (correction_vel*2) || z_vel_in > (correction_vel*2)) {
	// convert encoder velocity to volts
	volts = (encoder_vel - scale_offset) * vel_scale;
	if(volts < 0){volts = 0;} // make sure volts is not negative

        if(torch_on && arc_ok && !velocity_overide_active) { // && vel_status){   //&& arc_ok && vel_status){ // allow correction
            if(volts  > (volts_requested + voltage_tol)){
		z_vel_out = -.14;
	    }
            else if(volts < (volts_requested - voltage_tol)){
		z_vel_out = .14;
            }
	    else {
	    	z_vel_out = 0;
	    }	
        }

	if(velocity_overide_active){
		z_vel_out = z_vel_overide;
		float delta = (initial_fb + (.8 - .15)) - z_fb_in;
		if(delta < 0)
			delta *= -1; //make positive
		if(delta < .2) { //checking absolute value distance from destination
			z_vel_overide = 0;
			velocity_overide_active = false;
		}
	}
		
     }   

	debug_z_vel_overide = z_vel_overide;
	debug_torch_off_ticks = torch_off_ticks;
	debug_torch_on_ticks = torch_on_ticks;
	debug_initial_fb = initial_fb;

#if 0
    // convert encoder velocity to volts
    volts = (encoder_vel - scale_offset) * vel_scale;
    if(volts < 0){volts = 0;} // make sure volts is not negative
    
    if(enable){
        float min_velocity = requested_vel -(requested_vel*(1/velocity_tol));
        if(current_vel > 0 && current_vel >= min_velocity){vel_status = 1;}
        else {vel_status =0;}
        
        if(torch_on && arc_ok && vel_status){ // allow correction
            if((volts + voltage_tol) > volts_requested){
                offset -= correction_vel;
            }
            if((volts - voltage_tol) < volts_requested){
                offset += correction_vel;
            }    
            last_z_in = 0;
        }
        if(!torch_on){ // remove any offset
            // seems buggy in that offset never goes to zero after torch goes off
            // set offset to 0.0 if torch off
            offset = 0.0;
            #if 0
            float z_diff;
            z_diff = z_pos_in - last_z_in;
            if(z_diff > 0 && offset != 0){ // torch is moving up
                if(offset > 0){ // positive offset
                    if(offset > z_diff){ // remove some
                        offset -= z_diff;
                    }
                    else {offset = 0;}
                }
                if(offset < 0){ // negative offset
                    if(offset < z_diff){ // remove some
                        offset += z_diff;
                    }
                    else {offset = 0;}
                }
            }
            last_z_in = z_pos_in;
            #endif
        }
        z_pos_out = z_pos_in + offset;
        z_fb_out = z_pos_in; // keep axis motor position fb from being confused
    }
    else {
        z_pos_out = z_pos_in;
        z_fb_out = z_pos_in; // keep axis motor position fb from being confused
    }
#endif
}

