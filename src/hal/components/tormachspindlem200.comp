int is_spindle_stopped(void)
{
float encoder_spindle_speed;

        // look at both VFD feedback and encoder when you have encoder and it doesn't work

        if(orient_encoder_cpr != 1.0 && orient_encoder_cpr != 0.0) 
            encoder_spindle_speed = fabs(encoder_velocity); //we have an encoder, read velocity from it
        else
            encoder_spindle_speed = 0.0; //no encoder, speed from encoder is zero

        if (encoder_spindle_speed < RPM_CLOSE_TO_ZERO && fabs(vfd_rpm_feedback) < RPM_CLOSE_TO_ZERO)
            return 1; 
        return 0; //not stopped
}

// #############################################   Place callable functions that use component pins above this point 
// #############################################   ACTUAL START of FUNCTION(_) 
// #############################################   except for automatic variables and one previous and defensive  vfd_rpm_cmd = 0; statement  


// spindle-type - for high speed use only low belt params
    //                for speeder compensate for tripled output speed
    //                for standard pay attention to belt position
    switch (spindle_type) {
        default:
        case SPINDLE_TYPE_STANDARD:
            speeder_ratio = 1.0;
            desired_vfd_mode = VFD_MODE_DEFAULT;
            break;
        case SPINDLE_TYPE_HISPEED:
            speeder_ratio = 1.0;
            desired_vfd_mode = VFD_MODE_HISPEED;
            break;
        case SPINDLE_TYPE_SPEEDER:
            desired_vfd_mode = VFD_MODE_DEFAULT;
            if (speeder_factor != 0.0) { // use HAL value
                speeder_ratio = speeder_factor;
            }
            else {  // use default of SPEEDER_FACTOR_DEFAULT
                speeder_ratio = SPEEDER_FACTOR_DEFAULT;
            }
            break;
        case SPINDLE_TYPE_RAPID_TURN:
            desired_vfd_mode = VFD_MODE_RAPIDTURN;
            speeder_ratio = 1.0;
            break;
    }


    // set min and max speed from belt position
    // we default or assume hi belt except when HI speed spindle
    if (belt_position != BELT_POSITION_LOW) { //default HI belt unknowns, too
        pulley_ratio =  highbelt_ratio;
        min_speed = setValue(highbelt_min_rpm, DEF_HIGHBELT_MIN_RPM);
        max_speed = setValue(highbelt_max_rpm, DEF_HIGHBELT_MAX_RPM);
        step_speed = setValue(highbelt_step_rpm, DEF_HIGHBELT_STEP_RPM);
        step_tol_below = setValue(highbelt_tol_below, DEF_HIGHBELT_TOL_BELOW);
        step_tol_above = setValue(highbelt_tol_above, DEF_HIGHBELT_TOL_ABOVE);
    }
    else { //low belt case
        pulley_ratio = lowbelt_ratio;
        min_speed = setValue(lowbelt_min_rpm,DEF_LOWBELT_MIN_RPM);
        max_speed = setValue(lowbelt_max_rpm,DEF_LOWBELT_MAX_RPM);
        step_speed = setValue(lowbelt_step_rpm,DEF_LOWBELT_STEP_RPM);
        step_tol_below = setValue(lowbelt_tol_below,DEF_LOWBELT_TOL_BELOW);
        step_tol_above = setValue(lowbelt_tol_above,DEF_LOWBELT_TOL_ABOVE);
    }

    // test for speeder spindle type
    if (spindle_type == SPINDLE_TYPE_SPEEDER) {
        min_speed = min_speed * speeder_ratio;
        max_speed = max_speed * speeder_ratio;
        step_speed = step_speed * speeder_ratio;
        step_tol_below = step_tol_below * speeder_ratio;
        step_tol_above = step_tol_above * speeder_ratio;
    }

    // test for high speed spindle type
    if (spindle_type == SPINDLE_TYPE_HISPEED) {
        pulley_ratio = 1.0;
        // use high speed spindle min and max
        min_speed = setValue(hispeed_min,DEF_HISPEED_MIN_RPM);
        max_speed = setValue(hispeed_max,DEF_HISPEED_MAX_RPM);
        step_speed = setValue(hispeed_step_rpm,DEF_HISPEED_STEP_RPM);
        step_tol_below = setValue(hispeed_tol_below,DEF_HISPEED_TOL_BELOW);
        step_tol_above = setValue(hispeed_tol_above,DEF_HISPEED_TOL_ABOVE);
    }

    // range check and clamp speed-in between min and max (0.0 is OK for stopped)
    speed_alarm = BIT_FALSE;

    //note if orient_execute isn't hooked up, we assume it is going to be "0", which means this comp will behave in
    //the normal mode which doesn't index

    if (!(zindex_state & ISTATE_PAST) && !(zindex_state & ISTATE_WAITING)) {
        //system("halcmd sets spindle-orient-enable 1"); //command z index to happen
        zindex_enable = 1;
        zindex_state = ISTATE_WAITING;
    }
    else if ((zindex_state & ISTATE_WAITING) && (zindex_enable == 0)) {
        zindex_state = ISTATE_PAST | ISTATE_DONE;
    }

    // THIS SECTION figures out spinde_state and clears and initializes other state variables,
    // but doesn't to the heavy lifting of what the spindle_states mean
    if (orient_execute) {
        if(spindle_state!=SPINDLE_STATE_ORIENTING) { //if we just entered this state
            spindle_state = SPINDLE_STATE_ORIENTING;
            target_computed = 0;
            orient_problem = 0;
            orient_to = 0;
            orient_good_timer = 0;
            oriented = 0;
            orient_P2 = 0; //start at "PID 1" values
            orient_fault = 0; //clear last error, if any
            orienting_stuck = 0;
            orient_timer = 0.0;
            stuck_delay = ORIENT_LONG_ORIENT_TIME;
            if (orient_targetband_override != 0)
                orient_targetband = orient_targetband_override;
            else
                orient_targetband = ORIENT_TARGETBAND;
            orient_on_target = 0;
            orient_status = -.456; 
            //if (motor_hz_per_cmd_hz == 0.0)
            //    hz_per_cmd_hz = HZ_PER_HZ_DEFAULT;
            //else
            //    hz_per_cmd_hz = motor_hz_per_cmd_hz; //use eternal value
            // TODO: external over ride for ORIENT_HZ_PER_HZ_DEFAULT?, per the above commented out code??
            hz_per_cmd_hz = ORIENT_HZ_PER_HZ_DEFAULT;
            min_speed_freq_cmd = 0.0;
            max_speed_freq_cmd = VFD_BIPOLAR_FREQ_OFFSET;  //vfd_rpm2freq(max_speed, pulley_ratio, hz_per_cmd_hz, speeder_ratio);
            if (boost_disable) {
                cw_boost_min = cw_boost_step = ccw_boost_min = ccw_boost_step = 0;
            }
            else {
                if (orient_encoder_cpr < 0) { //presumably, encoder CPR never changes but calculate these once at start of every orient
                    cw_boost_min = orient_boost_min;
                    cw_boost_step = orient_boost_step;
                    ccw_boost_min = orient_boost_min * -1.0;
                    ccw_boost_step = orient_boost_step * -1.0;
                }
                else {
                    cw_boost_min = orient_boost_min * -1.0;
                    cw_boost_step = orient_boost_step * -1.0;
                    ccw_boost_min = orient_boost_min;
                    ccw_boost_step = orient_boost_step;
                }
            }
            orient_start = encoder_position; //record whence we came for ORIENT_ERR_MAX_ROTATION check so we don't false on error
                                             //if spindle is decell'ing from previous operation, this is overwritten again when VFD mode switch happens
            orient_max_encoder_steps = (signed int)((float)iabs(orient_encoder_cpr) * ORIENT_MAX_REVS);
                
#if (_38_SPECIAL)
            orient_total_ticks = 0;
#endif
        }
    }
    else if (spindle_lock) {
        if(spindle_state!=SPINDLE_STATE_LOCKED) { //if just entered this state
            if(spindle_state!=SPINDLE_STATE_ORIENTING) { //must enter from orient state
                orient_fault = ORIENT_ERR_LOCK_WITHOUT_PRIOR_ORIENT; //flag the error
                spindle_state = SPINDLE_STATE_NORMAL; // moving to "normal" is only SPINDLE_STATE that makes sense, even though we have an error
                spindle_on_thur = BIT_FALSE;  //redundant stop spindle
            }
            else {
                spindle_state = SPINDLE_STATE_LOCKED; //move to this state even if error
                orient_P2 = 1; //switch to 2nd PID constants
                if (!oriented) {
                    orient_to = 1;
                    orient_problem |= 1;
                //    orient_fault = ORIENT_ERR_TIME_OUT; //TODO does this mess up linuxcnc net M19???
                }
            }
        }
        oriented = 0;
    }
    else if (orient_set_bt30){
        if ((spindle_state != SPINDLE_STATE_NORMAL) || !is_spindle_stopped() )
            orient_fault = ORIENT_ERR_BT30;
        //errors or not, we clear all these before finishing the bt30 set operation
        orient_set_bt30 = 0;   // the user looks at this to go low to know it completed, and can look at fault code to see if err
        orient_fault = 0;
        oriented = 0;
        vfd_rpm_cmd = 0.0;
        spindle_on_thur = BIT_FALSE; //never enable spindle for bt30 setting
        if (zindex_state != (ISTATE_PAST | ISTATE_DONE)) {
            orient_fault = ORIENT_ERR_NO_ZINDEX; //we've yet to see an encoder z index -- error out
        }
        else { //we're in orient_set_bt30 mode, no errors detected
            bt30_offset = normalizedMod(encoder_position,orient_encoder_cpr);
        }
    }
    else { //normal spindle operation
        if(spindle_state != SPINDLE_STATE_NORMAL) { //if just entering normal spindle state
            if(spindle_state == SPINDLE_STATE_ORIENTING && !oriented) {
                orient_to = 1;
                orient_problem |= 2 ;
         //       orient_fault = ORIENT_ERR_TIME_OUT; setting this here goofs up linuxcnc such that it will never attempt another M19
            }
            spindle_state = SPINDLE_STATE_NORMAL;
            orient_fault = 0; //clearing this here means orient_fault is only active for 1 ms!, but otherwise see above "never attempt another M19"
            orient_on_target = 0;
            orient_status = -.4567;
            if (motor_hz_per_cmd_hz == 0.0)
                hz_per_cmd_hz = HZ_PER_HZ_DEFAULT;
            else
                hz_per_cmd_hz = motor_hz_per_cmd_hz; //use eternal value

            // calculate clamps for vfd_freq_cmd to acceptable ranges once
            min_speed_freq_cmd = vfd_rpm2freq(min_speed, pulley_ratio, hz_per_cmd_hz, speeder_ratio);
            max_speed_freq_cmd = vfd_rpm2freq(max_speed, pulley_ratio, hz_per_cmd_hz, speeder_ratio);
        }
    }

    //Now we can do the heavy lifting of spindle_states

    if(spindle_state == SPINDLE_STATE_ORIENTING || spindle_state == SPINDLE_STATE_LOCKED) {
        if (orient_set_bt30){
            orient_fault = ORIENT_ERR_MULTIPLE_COMMANDS;
        }
        else { //no errors detected. do orient PID
            desired_vfd_mode = VFD_MODE_ORIENT;
#if (_38_SPECIAL)
            if(orient_angle == 38.0)  { //do special orient
                execute_impulse();
            }
            else { //place for normal orient when 38_special is compiled in 
#endif  //end of _38_SPECIAL, normal orient below here
            //TODO: indent problems here

            //########## NORMAL ORIENT STARTS HERE:
            orient_timer += fperiod;

            if (finding_z_index && (zindex_state == (ISTATE_PAST | ISTATE_DONE))) { //if Z index wasn't seen and now has
                //finding_z_index = 0; //DO NOT change state here, done inside calcFeedback()  (finding_z_index stores the CW or CCW direction)
                target_computed = 0; //force re-calculation of target, as 1st attempt was bad since we didn't have a Z index
                orient_start = encoder_position;    //new whence we came for ORIENT_ERR_MAX_ROTATION err check as encoder 0 has shifted, potentially by millions if FPGA was running before PP
                orient_max_encoder_steps = (signed int)((float)iabs(orient_encoder_cpr) * ORIENT_MAX_REVS);  //restrict this range to, was bigger 
            }

            if (vfd_mode != VFD_MODE_ORIENT) //if we're waiting for spindle to stop from previous normal operation, then vfd_mode will still be "normal"
                spindle_on_thur = BIT_FALSE; //probably redundant, possible error condition, turn off spindle anyway as we're waiting for spindle to stop from previous operation
            else { //VFD should be in the VFD_MODE_ORIENT mode, AFAIK so check for errors
#if (!(TEST_SPINDLE_LOCK)) 
                if ((encoder_position > (orient_start + orient_max_encoder_steps)) || (encoder_position < (orient_start - orient_max_encoder_steps))) {
                    spindle_on_thur = BIT_FALSE; //error condition, turn off spindle!
                    orient_fault = ORIENT_ERR_MAX_ROTATION; //this flags linuxcnc to stop orient cycle
                }
                else //no error detected
#endif //end TEST_SPINDLE_LOCK
                    spindle_on_thur = BIT_TRUE;  //always enable the spindle in orienting mode
            }

#if (VFD_BIPOLAR_MODE)
            spindle_forward_thur = BIT_TRUE;  //true selects forward on m200, but ignored by VFD as freq also controls direction
            vfd_rpm_cmd = orient_speed_in;
#else
            if(orient_speed_in >= 0)  //figure out spindle dir based on input from index PID
                spindle_forward_thur = BIT_TRUE;  //true selects forward on m200
            else
                spindle_forward_thur = BIT_FALSE; //false selects reverse on m200

            vfd_rpm_cmd = fabs(orient_speed_in);
#endif
     
            orient_modulus = fbFilter(calcFeedback(orient_mode));
            enc_err = orient_target - encoder_position;

            //don't switch to orient_P2 until we actually are orienting.  In other words, vfd_mode doesn't change until we stop decelerating from normal spindle mode.
            if((vfd_mode == VFD_MODE_ORIENT) && (iabs(enc_err) < P2_transition)) //P2_transistion was magic # 65 for 1100
                orient_P2 = 1; //turn on 2nd orient

            if (orient_P2) {
                pidP = pidP2in;
                pidD = pidD2in;
                pidI = pidI2in;
            }
            else {
                pidP = pidP1in;
                pidD = pidD1in;
                pidI = pidI1in;
            }

            //since orient_on_target is using tighter tolerance than orient_targetband, we
            //have to deal with orient_status separately
            if (spindle_state == SPINDLE_STATE_LOCKED) {
                if (enc_err <= -1 * iabs(orient_targetband + ORIENT_BAND_IGNORE))
                    orient_status = (float)enc_err; //SLP DEBUG test to simply return enc_err restore this -1.0;
                else if (enc_err >= iabs(orient_targetband + ORIENT_BAND_IGNORE))
                    orient_status = (float)enc_err; //SLP restore this 1.0; (or maybe not)
                else
                    orient_status = 0.0;
                if (orient_status)
                    orient_problem |= 4;
            }
//            else { //presently setting to "invalid" number incase ATC code samples this at "wrong" time for this variable.  It'll generate a fault as ATC code is looking for it to be zero or not.
//                    //DEBUG statements in .ngc files are logging the return ... if we see this MAGIC NUMBER, then we know it was sampled at wrong time
//                orient_status = -.456789;//SLP return to 0 //lie it's all OK until as not error yet since orient hasn't finished
//            }

            if(iabs(enc_err) < orient_targetband) { //Yes, we want <, not <=. Assume orient_targetband = 8. Encoders are integral, so if <= can reach 8 + very nearly 1 = 9 rotations before we see it. When <8 then
                                                    // value is 7 + nearly 1 
            //if(iabs(enc_err) <= (orient_targetband/2)){ //if indexing feedback is good for ORIENT_TARGETBAND_TIME, _AND_ vfd_freq_cmd is stable too, call it done
                                                //however, we don't calculate vfd_freq_cmd until much later. So the vfd_freq_cmd stablity isn't checked here yet
                                                //and it can reset/restart orient_good_timer at very end of this comp when vfd_freq_cmd isn't stable
                if (spindle_state == SPINDLE_STATE_LOCKED) 
                    orient_on_target = 1;
                if (spindle_state == SPINDLE_STATE_ORIENTING) {
                    orient_good_timer += fperiod;
                    if (orient_good_timer >= ORIENT_TARGETBAND_TIME) {
                        if (finding_z_index) {
                            orient_fault = ORIENT_ERR_NO_ZINDEX; //we tried and failed to find Z index pulse 
                            orient_problem |= 8;
                        }
                        else oriented = 1;
                    }
                }
            }
            else {
                orient_good_timer = 0.0;
                orient_on_target = 0;
//Debug                if (spindle_state == SPINDLE_STATE_LOCKED)
//Debug                    orient_to = 1; //abuse this pin to indicate holding error
            }
                if((iabs(enc_err) > (orient_targetband/2)) && (orient_timer > stuck_delay)) {
                if(!orienting_stuck) {
                    orienting_stuck_timer += fperiod;
                    if (orienting_stuck_timer >= ORIENT_STUCK_PREAMBLE_TIME) {
                            orienting_stuck = 1;
                            orienting_stuck_timer = 0.0; //restart timer for next stage
                            orienting_stuck_last = encoder_position;
                            if (enc_err > 0)
                                orienting_boost = ccw_boost_min;
                            else orienting_boost = cw_boost_min;
                    }
                }
                else { //previously detected no encoder movement outside of (orient_targetband/2) for ORIENT_STUCK_PREAMBLE_TIME
                    if (encoder_position == orienting_stuck_last) {
                        orienting_stuck_timer += fperiod;
                        if (orienting_stuck_timer >= ORIENT_BOOST_PERIOD) {
                            orienting_stuck_timer = 0.0; //restart timer for next ORIENT_BOOST_PERIOD
                            if (enc_err > 0) {  //what's the polarity of boost?
                                if(orienting_boost == 0) //if no previous boost, jump start it
                                    orienting_boost = ccw_boost_min;
                                else
                                    orienting_boost += ccw_boost_step; //previously active boost, just nudge it a little
                            }
                            else {
                                if(orienting_boost == 0) //if no previous boost, jump start it
                                    orienting_boost = cw_boost_min;
                                else
                                    orienting_boost += cw_boost_step; //previously active boost, just nudge it a little
                            }
                        }
                    }
                    else {
                        orienting_stuck_last = encoder_position; //new "stuck" position, however now it's more of a "last" position, as the encoder could be moving
                        //orienting_stuck = 0; //TODO: an option would be to exit the "stuck" mode, however we won't right now.  This means we will
                        // start boosting again in ORIENT_BOOST_PERIOD secs, rather than (ORIENT_STUCK_PREAMBLE_TIME + ORIENT_BOOST_PERIOD) secs
                        orienting_boost = 0.0; //movement seen, stop orienting_boost immediately so we don't over shoot.
                    }
                }

                if (orienting_boost){ //if we don't limit, we can cause over current faults from VFD
                    if (iabs(orienting_boost) < ORIENT_MAX_BOOST)
                        vfd_rpm_cmd += orienting_boost; //add the boost, if any because we're stuck.
                    else {
                        if (orienting_boost >= 0)
                            vfd_rpm_cmd += ORIENT_MAX_BOOST;
                        else vfd_rpm_cmd -= ORIENT_MAX_BOOST;
                    } 
                }
            }
            else {
                orienting_boost = 0.0; //guarantee this is not being done since we're inside targetband and/or ORIENT_LONG_ORIENT_TIME hasn't happened yet
            }

#if _38_SPECIAL
        } //end normal orient else case when 38 special enabled (compiled in)
#endif
        }
    }
    else { //normal spindle operation, no orienting or bt30 setting active
        vfd_rpm_cmd = fabs(speed_in);
        spindle_on_thur = spindle_on; //pass thur in this mode
        spindle_forward_thur = forward_in; //pass thur in this mode

        if (vfd_rpm_cmd < min_speed) {
            // under min
            speed_alarm = BIT_TRUE;
            vfd_rpm_cmd = min_speed;
        }
        else if (vfd_rpm_cmd > max_speed) {
            // over max
            speed_alarm = BIT_TRUE;
            vfd_rpm_cmd = max_speed;
        }
    }

    //Now compute vfd_rpm_cmd

    if (enc_door_switch_configured == 1 && enc_door_switch_status == 1 && fabs(vfd_rpm_cmd) > enc_door_open_max_rpm) {
        if (vfd_rpm_cmd >= 0.0)
            vfd_rpm_cmd = enc_door_open_max_rpm;
        else
            vfd_rpm_cmd = -1.0 * enc_door_open_max_rpm;
    }

    // compute frequency to send to VFD commanded speed input.
    // this is always computed for all states of VFD
    // freq_cmd = spindle_rpm /  pulley_ratio / 60 * motor_hz_per_cmd_hz
    vfd_freq_cmd = vfd_rpm2freq(vfd_rpm_cmd, pulley_ratio, hz_per_cmd_hz, speeder_ratio);

#if (TEST_SPINDLE_LOCK)   
    // DEBUG test to try to and move spindle when in lock mode to test locking timing 
    if (spindle_state == SPINDLE_STATE_LOCKED) 
        vfd_freq_cmd = 5140; //approx 100 RPM //6000 approx 715 RPM; 
#endif

// no longer necessary with VFD_BIPOLAR_MODE operation, as vfd_rpm_cmd is signed now throughout code
//    if (spindle_forward_thur == 0) //if reverse, flip sign of vfd_rpm_cmd ... this is a DEBUG operation, does nothing useful
//        vfd_rpm_cmd = -1.0 * vfd_rpm_cmd;

    // clamp vfd_freq_cmd to acceptable range using previously calculated min_speed_freq_cmd and max_speed_freq_cmd value
    if (fabs(vfd_freq_cmd) < min_speed_freq_cmd) {
        if(vfd_freq_cmd >= 0.0)
            vfd_freq_cmd = min_speed_freq_cmd;
        else
            vfd_freq_cmd = -1.0 * min_speed_freq_cmd;
    }
    else if (vfd_freq_cmd > max_speed_freq_cmd) {
        if(vfd_freq_cmd >= 0.0)
            vfd_freq_cmd = max_speed_freq_cmd;
        else
            vfd_freq_cmd = -1.0 * max_speed_freq_cmd;
    }


/* Where we add MAGIC_VFD_FREQ_OFFSET if necessary ...
    if(spindle_state == SPINDLE_STATE_ORIENTING || spindle_state == SPINDLE_STATE_LOCKED) {
        //vfd_freq_cmd += vfd_freq_offset; //MAGIC_VFD_FREQ_OFFSET;  //below ~41 hertz means VFD 0 RPM. We're trying to offset that here
                                //one doesn't need to worry about the absolute value, as vfd_freq_cmd always positive
    }
*/

    if (vfd_feedback_factor != 0.0) //if set externally, use it
        vfd_feedback_ratio = vfd_feedback_factor;
    else vfd_feedback_ratio = DEFAULT_VFD_FEEDBACK_FACTOR;

    // low pass filter - feedback is jumpy sometimes
    feedback_motor_rpm += ((fabs(vfd_rpm_feedback) * vfd_feedback_ratio) - feedback_motor_rpm) * 0.1;

    //orient_encoder == 1 means no encoder. Can't reall set to "0" as linuxcnc/src/hal/drivers/mesa-hostmot2/encoder.c uses
    // this value as a divisor.  Yet we wish to allow a "generic" HALs to ignore & not connect
    //this pin, in which case it's going to be 0 here.  Our base HAL files set ENCODER_SCALE "1" to indicate no encoder.
    //a specific ini that then doesn't define ENCODER_SCALE at all means it will be "1" here
    if(orient_encoder_cpr == 1.0 || orient_encoder_cpr == 0.0) //if no spindle encoder
    	feedback_spindle_rpm = feedback_motor_rpm * pulley_ratio; // use VFD's feedback, which isn't so accurate
    else { //TODO:
        //use the encoder and TODO add verify VFD motor speed feedback is working and/or alert wrong belt ratios, etc
    	//feedback_spindle_rpm = fabs(vFilter((double)encoder_velocity)) * (double)60.0;
        //encoder_timer += fperiod;
        //if (encoder_timer >= ENCODER_SEC)
       // {
            //feedback_spindle_rpm = ((((float)encoder_position) - ((float)last_encoder_position)) / ((float)orient_encoder_cpr)) * ((float)60.0);
         //   last_encoder_position = encoder_position;
          //  encoder_timer = 0.0;
        //}
        feedback_spindle_rpm = filteredRPM((double)encoder_position, (double)fperiod);
    }
    // spindle-at-speed check

    if (feedback_motor_rpm <= RPM_CLOSE_TO_ZERO) { 
        feedback_motor_rpm = 0.0;   //set to perfect zero.  This has effects in linuxcnc code???  We don't want .0001 RPM issues
    }   

    if (spindle_state == SPINDLE_STATE_ORIENTING || spindle_state == SPINDLE_STATE_LOCKED) {
        at_speed = BIT_FALSE;
        speed_out = feedback_spindle_rpm;
        speed_alarm = BIT_FALSE;
    }
    else if (spindle_on && (iabs(vfd_rpm_cmd) > 0.0)) {
        if (at_speed == BIT_FALSE) {
            if (at_speed_force == BIT_TRUE) {
                at_speed_force_timer += fperiod;
                if (at_speed_force_timer > AT_SPEED_FORCE_DELAY_SECS) {
                    at_speed = BIT_TRUE;
                    at_speed_force_timer = 0.0;
                }
            }
            // not yet at speed
            // speed-out pin will track VFD feedback until "at speed" after which
            // speed-out will be reported as the commanded speed
            speed_out = feedback_spindle_rpm;
     
            // at the very bottom end the feedback speed falls off from commanded
            if (iabs(vfd_rpm_cmd) < step_speed) {
                tolerance = step_tol_below/100.0;
            }
            else {
                tolerance = step_tol_above/100.0;
            }
            if (is_close_enough(fabs(speed_out), iabs(vfd_rpm_cmd), tolerance)) {
                // the M200 outputs a burst of noise approximately 1 second after
                // its power on boot that
                // causes a false positive 'at-speed' indication long before the
                // the spindle is turning let alone anywhere near at speed
                // said noise is observed to be 65 ms in duration
                // require a steady state feedback at-speed for AT_SPEED_DEBOUNCE_SECS
                // before declaring the spindle is 'at-speed'
                at_speed_debounce += fperiod;
                if (at_speed_debounce > AT_SPEED_DEBOUNCE_SECS) {
                    // spindle should now be at speed
                    at_speed = BIT_TRUE;
                    at_speed_debounce = 0.0; //without this, the debounce only happens once
                }
            }
            else {
                // not at-speed so reset debounce timer
                at_speed_debounce = 0.0;
            }
        }
        // in at-speed state - speed-out follows speed-in
        else {
            speed_out = iabs(vfd_rpm_cmd);
            // uncomment next line for debugging or to display feedback RPM in UI
            //speed_out = feedback_spindle_rpm
        }
    }
    else {
        // spindle is off
        at_speed = BIT_FALSE;
        speed_out = 0.0;
        speed_alarm = BIT_FALSE;
        vfd_freq_cmd = 0.0;
    }

    if (disable) { //do this last  TODO: This may fault the drive, but do we care???
        // no spindle motion allowed
        vfd_freq_cmd = 0.0;
        spindle_on_thur = 0;
        speed_out = 0.0;
    }

    if (vfd_freq_cmd == 0.0)
        vfd_rpm_cmd = 0.0; //just debugging output

#if (VFD_BIPOLAR_MODE)
    if(spindle_state == SPINDLE_STATE_ORIENTING || spindle_state == SPINDLE_STATE_LOCKED) {
        vfd_freq_cmd += VFD_BIPOLAR_FREQ_OFFSET;
        if(vfd_freq_cmd < VFD_BIPOLAR_MIN_FREQ)  //error range checking, plus we want to avoid 0 Hz command to drive
            vfd_freq_cmd = VFD_BIPOLAR_MIN_FREQ;
        if(vfd_freq_cmd > VFD_BIPOLAR_MAX_FREQ)
            vfd_freq_cmd = VFD_BIPOLAR_MAX_FREQ;
    }
    else   //this else is tricky but is correct to fabs(vfd_freq_cmd) always when not VFD_BIPOLAR_MODE, and conditionally (i.e. else case)
#endif
       vfd_freq_cmd = fabs(vfd_freq_cmd);

    if(orient_encoder_cpr == 0.0 || orient_encoder_cpr == 1.0) //means no encoder. not setting to "0" as linuxcnc/src/hal/drivers/mesa-hostmot2/encoder.c uses this as a divisor, so !=0, yet we wish to allow HAL to not connect
    //this pin, in which case it's going to be 0
        speed_out_rps = speed_out / 60.0;
    else
        speed_out_rps = feedback_spindle_rpm/60; // encoder_velocity;  //feed thur of velocity
            // we are filtering rps into feedback_spindle_rpm above, so use it, not raw encoder_velocity i.e. "feedback_spindle_rpm = fabs(vFilter(encoder_velocity)) * 60;"

    if(vfd_mode != desired_vfd_mode) {
        if (is_spindle_stopped()) { //wait for any pending spindle motion to be "Zero" before switching modes
            //previous_vfd_mode = vfd_mode; //record last active VFD mode
            vfd_mode = desired_vfd_mode; //this is now the mode we are about to tell the VFD to do
        }

        orient_start = encoder_position; //we must keep resetting this throughout the deceleration, or ORIENT_ERR_MAX_ROTATION error will occur
        target_computed = 0; //force new orient target to be computed, as spindle is moving
        spindle_on_thur = 0; //over ride any previous "on" of this pin.  If was normal M3 S1000 "running", then this decels drive using "normal" VFD curves
        vfd_mode_switch_timer = VFD_MODE_SWITCH_DELAY + fperiod;    //start timer, or keep reloading while moving so timing begins from instant spindle stops and doesn't include decel time. 
                                                                    //+fperiod makes sense else time will be VFD_MODE_SWITCH_DELAY - fperiod.
        stuck_delay = ORIENT_LONG_ORIENT_TIME + VFD_MODE_SWITCH_DELAY; //VFD_MODE_SWITCH_DELAY must expire before deciding ORIENT_LONG_ORIENT_TIME has passed
    }

    if (vfd_mode_switch_timer > 0.0) { //give VFD time to switch modes.  Timer is active when above 0
        vfd_mode_switch_timer -= fperiod;
        spindle_on_thur = BIT_FALSE;    //over ride any previous "on" of this pin
        if ((spindle_state == SPINDLE_STATE_ORIENTING) || (spindle_state == SPINDLE_STATE_LOCKED)) {
            //none of these timers should be tallying during VFD RUN inhibit active, so reset them
            orienting_stuck_timer = 0.0;
            orienting_boost = 0.0;
            orient_good_timer = 0.0;
        }

        //at VFD_FREQ_CMD_TO_ENABLE_DELAY of the way through the vfd_mode_switch_timer, we actually switch the mode pins to the VFD
        //it will subsequently repeat this switch each time through the m200.comp loop until vfd_mode_switch_timer times out
        //DO NOT look for vfd_mode_switch_timer _equals_ (VFD_MODE_SWITCH_DELAY - VFD_FREQ_CMD_TO_ENABLE_DELAY) here, as fperiod is far from a perfect 1 mS each comp loop
        if (vfd_mode_switch_timer < (VFD_MODE_SWITCH_DELAY - VFD_FREQ_CMD_TO_ENABLE_DELAY)) {
            switch (vfd_mode) {
            default:
            case VFD_MODE_DEFAULT:
                vfd_mode0 = 0;
                vfd_mode1 = 0;
                break;
            case VFD_MODE_RAPIDTURN:
                vfd_mode0 = 1;
                vfd_mode1 = 0;
                break;
            case VFD_MODE_HISPEED:
                vfd_mode0 = 0;
                vfd_mode1 = 1;
                break;
            case VFD_MODE_ORIENT:
                orient_start = encoder_position; //record whence we came
                vfd_mode0 = 1;
                vfd_mode1 = 1;
                break;
            }
        }
    }

    //these next two delays (vfd_hold_freq_cmd_timer and vfd_enable_inhibit_timer) avoid cooincident VFD RUN (a.k.a. spindle_on_thur) pin and vfd_freq_cmd changes so 
    //VFD's internal error detection isn't glitched.  

    //When spindle_on_thur is turning off, the vfd_freq_cmd is held at a nominial minimum RPM command 
    //that makes sense to the VFD based on the last VFD mode.  For transistion from normal spindle mode, "0" can't be used
    // so VFD_UNIPOLAR_MIN_FREQ is as close as we can get without faulting the VFD

    if (spindle_on_thur_last == BIT_TRUE && spindle_on_thur == BIT_FALSE) { // spindle on to off edge detection
        vfd_hold_freq_cmd_timer = VFD_FREQ_CMD_TO_ENABLE_DELAY;  //start timer to inhibit vfd_freq_cmd change
    }

    if(vfd_hold_freq_cmd_timer > 0.0) {
        vfd_hold_freq_cmd_timer -= fperiod;        

        if (last_active_spindle_state == SPINDLE_STATE_ORIENTING || last_active_spindle_state == SPINDLE_STATE_LOCKED)
            vfd_freq_cmd = VFD_BIPOLAR_FREQ_OFFSET; 
        else
            vfd_freq_cmd = VFD_UNIPOLAR_MIN_FREQ;
    }
    else 
        last_active_spindle_state = spindle_state; //determines what vfd_freq_cmd to hold when spindle_on_thur goes inactive.  See vfd_hold_freq_cmd_timer.

    //When spindle_on_thur is turning on, allow possible vfd_freq_cmd change to be detected by VFD before allowing VFD RUN to be enabled. Add a delay to the VFD RUN 
    if(spindle_on_thur_last == BIT_FALSE && spindle_on_thur == BIT_TRUE) { //spindle off to on edge detection
        vfd_enable_inhibit_timer = VFD_FREQ_CMD_TO_ENABLE_DELAY + fperiod; //start timer to avoid glitching VFD with simultaneous RUN and vfd-freq-cmd transistions
    }

    spindle_on_thur_last = spindle_on_thur; //save new state before we possibly clobber it with BIT_FALSE below

    if(vfd_enable_inhibit_timer > 0.0) {
        vfd_enable_inhibit_timer -= fperiod;
        spindle_on_thur = BIT_FALSE;  //inhibit VFD enable (RUN)
    }

    if (!vfd_24V) //bad when not hi
        orient_problem |= 0x10;
    if (vfd_fault)
    {
        orient_problem |= 0x20;
        spindle_on_thur = BIT_FALSE;
           
    }
}


