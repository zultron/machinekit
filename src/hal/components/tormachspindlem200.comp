component tormachspindlem200 "Tormach Spindle HAL Component M200";

license "GPL";
author "";

// Purpose:
//
// For Tormach mill M200 VFD driven by ECM1.
// Direction is controlled by a discrete electrical signal outside this comp for normal (non-indexing) mode.
// With the addition of spindle indexing using an encoder, the direction signal is routed through this comp
// and is simple pass-thur for normal operation.  Likewise "spindle-on" is routed as pass thur for normal mode.
// When indexing,  direction and spindle-on are controlled by this comp.
//
// Alarm checking and VFD frequency drive
//
// Inputs:
//
//          disable                 0 = normal operation, 1 = no spindle rotation
//
//          spindle-type            0 = standard, 1 = speeder, high speed = 2
//                                  standard honors belt position and low/high min/max
//                                  speeder multiplies the values in min/max by speeder-factor
//                                  high speed ignores belt position and uses hispeed-min and hispeed-max always
//
//          lowbelt-min-rpm         minumum RPM in low belt
//          lowbelt-max-rpm         maximum RPM in low belt
//
//          highbelt-min-rpm        minimum RPM in high belt
//          highbelt-max-rpm        maximum RPM in high belt
//
//          highbelt-ratio          motor to spindle pulley ratio in high belt
//          lowbelt-ratio           motor to spindle pulley ratio in low belt
//
//          hispeed-min             maximum RPM for high speed spindle-type
//          hispeed-max             minimum RPM for high speed spindle-type
//
//          motor-hz-per-cmd-hz     motor Hz per input Hz (defaults 20.0)
//
//          speed-in                driven by motion.spindle-speed-out
//          belt-position           1 -> high belt, 0 -> low belt position
//          speeder-factor          defaults to 3.0 - applied to min/max if spindle-type == speeder
//
//          enc-door-switch-configured  pay attention to the door switch input to limit RPM when open
//          enc-door-switch-status      limit spindle speed when enclosure door is open (pin is 0)
//          enc-door-open-max-rpm       speed limit when enclosure door is open
//          vfd-feedback-factor     ratio of feed back signal (2 for 770 or 3 for 1100).
//                                  We wanted consistent 3 for all m200 VFDs, but 770s VFDs got shipped with 2 ratio
//          highbelt-step-rpm       rpm below which we expand tolerance when in highbelt
//          lowbelt-step-rpm        rpm below which we expand tolerance when in lowbelt
//          highbelt-tol-below      what the rpm tolerance is below highbelt-step-rpm
//          highbelt-tol-above      what the rpm tolerance is above or equal to highbelt-step-rpm
//          lowbelt-tol-below       what the rpm tolerance is below lowbelt-step-rpm
//          lowbelt-tol-above       what the rpm tolerance is above or equal to lowbelt-step-rpm
//          hispeed-step-rpm        rpm below which we expand tolerance when in lowbelt
//          hispeed-tol-below       what the rpm tolerance is below hispeed-step-rpm
//          hispeed-tol-above       what the rpm tolerance is above or equal to hispeed-step-rpm
//
// Outputs:
//
//          speed-alarm             if true then speed-in is out of range for the current belt position - connect to UI
//          vfd-freq-cmd            Hz to send to VFD to achieve desired motor RPM
//                                  This is a velocity command to a stepgen comp that drives the ECM1
//
// Spindle-at-speed:                Drive motion.spindle-at-speed based on frequency feedback from VFD_RUNNING signal
//
//                                  Determined by comparing VFD motor RPM times pulley ratio "close enough" to commanded speed

////////////////// Start of orient additions
// Inputs:
//          orient-execute          orient the spindle - when set, we're in orient mode for this comp
//                                  driven by motion.spindle-orient
//          orient-angle            desired orientation angle in degrees (M19's "R" parameter)
//                                  driven by motion.spindle-orient-angle
//          orient-mode             Orient mode 0 = minimum path rotation 1 = rotate CW (fwd dir) 2 = rotate CCW (rev dir)
//                                  This is M19's "P" parameter
//                                  driven by motion.spindle-orient-mode
//          orient-speed-in         vel command input from indexing pid entity, when in "index" mode
//          orient-encoder-cpr      encoder counts per rev
//          encoder-position        encoder counts (position) input from the spindle encoder (resetable with zindex-enable)
//          encoder-velocity        encoder velocity input
//          encoder-rawcounts       encoder raw counts
//          encoder-rawlatched      encoder raw latched input
//   
//          forward_in              input from linuxcnc motion entity, used when not in index mode for feed thur
//          spindle-lock            from linuxcnc motion.spidle-lock
//          zindex-test             execute zindex testing
// Outputs:
//          orient-modulus          feedback to pid block used control indexing of spindle
//          oriented                feedback to linuxcnc that index is within range.  Connect to motion.spindle-is-oriented
//          orient-fault            feedback to linuxcnc for fault code.  Connect to motion.spindle-orient-fault
//          spindle_run         feedthrough of forward-in when not indexing, set by this comp when indexing mode
//          vfd-pwr-on              output to turn on K2 contactor
//          spindle-forward-thur    feedthrough of spindle-on when not indexing, set by this comp when indexing mode
//          orient-status           0 -> oriented, -1 or 1 error direction if not oriented
// Bi-directional:
//          zindex-enable           used to set spindle encoder's "index-enable" bit to align encoder counts to zero at next z-index
//         orient-set-bt30           when set starts bt30 indexing mode
     
///////////////////// End of orient additions
//          spindle-fault           used to alert PP GUI to spindle and VFD faults
//
// HAL mappings:
//
//    Inputs:
//          speed-in                motion.spindle-speed-out
//          spindle-on              motion.spindle-on
//          forward-in              motion.spindle-forward
//          at-speed-force          used to force one to at-speed after AT_SPEED_FORCE_DELAY_SECS
//
//    Outputs:
//          at-speed             => motion.spindle-at-speed
//          speed-out               open loop speed-out in RPM
//          speed-out-rps           connect to UI for display during gcode program execution
//                                  Also used by linuxcnc for G95 feed rate control and hardtapping (if we have a real encoder on spindle)
// TODO: list the I/O added for orienting


// This HAL comp does the math to achieve commanded spindle RPM in current hi/lo range
// it uses: commanded speed, belt-position/pulley ratio, motor Hz per command Hz
// examples for PCNC 770:
// 10200 / 1.5 (belt ratio) => 6800 (motor RPM) / 60 => 113.333333 motor Hz * 20 (motor Hz per command Hz) => 2266.666667 Hz (freq sent to VFD)
// 525 / 1.5 => 350 / 60 => 5.833333 * 20 => 116.666667 Hz command
// 3250 / 0.477941 => 6800 / 60 => 113.333333 * 20 => 2266.666667 Hz command
// 175 / 0.477941 => 366.153981 / 60 => 6.102566 * 20 => 122.051327 Hz command

// standard, speeder, high speed, or rapid-turn
pin in s32 spindle_type;

// connect to motion.spindle-speed-out
pin in float speed_in;

pin in bit at_speed_force;  //A debugging pin.  When set, at_speed will be forced true after AT_SPEED_FORCE_DELAY_SECS
// connect to motion.spindle-at-speed
pin out bit at_speed;
pin out float at_speed_debounce;
pin out float at_speed_force_timer;

// connect to motion.spindle-on
pin in bit spindle_on;

// this inbits the spindle from turning no matter what is commanded
pin in bit disable;

// connect to UI
pin out float speed_out_rps;
pin out float speed_out;

// hi-low belt position
pin in bit belt_position;

pin in float lowbelt_min_rpm;
pin in float lowbelt_max_rpm;

pin in float highbelt_min_rpm;
pin in float highbelt_max_rpm;

pin in float highbelt_ratio;
pin in float lowbelt_ratio;

pin in float highbelt_step_rpm;     // rpm below which we expand tolerance when in highbelt
pin in float lowbelt_step_rpm;      // rpm below which we expand tolerance when in lowbelt
pin in float highbelt_tol_below;    // what the rpm tolerance is below highbelt-step-rpm
pin in float highbelt_tol_above;    // what the rpm tolerance is above or equal to highbelt-step-rpm
pin in float lowbelt_tol_below;     // what the rpm tolerance is below lowbelt-step-rpm
pin in float lowbelt_tol_above;     // what the rpm tolerance is above or equal to lowbelt-step-rpm
pin in float hispeed_step_rpm;      // rpm below which we expand tolerance with highspeed spindle
pin in float hispeed_tol_below;     // what the rpm tolerance is below highspeed-step-rpm
pin in float hispeed_tol_above;     // what the rpm tolerance is above or equal to highspeed-step-rpm

pin in float motor_hz_per_cmd_hz;
pin in float vfd_rpm_feedback;
pin in bit vfd_fault;   //gpio 053
pin in bit vfd_24V;     //gpio 055

//#if _38_SPECIAL  TODO: Condition won't work in this section of this .comp ... uncomment these lines to manually enable _38_SPECIAL
//pin out bit last_fwd;
//pin out float last_rpm;
//pin out u32 orient_total_ticks;
//#endif

// current min and max speeds based upon spindle-type and belt-position
pin out float min_speed;
pin out float max_speed;
pin out float step_speed;
pin out float step_tol_below;
pin out float step_tol_above;

// when true this forces hispeed spindle type no matter the value of spindle-type
pin in bit is_hispeed;

pin in float hispeed-min;
pin in float hispeed-max;

pin in float speeder_factor;

pin out bit speed_alarm;
pin out float vfd_freq_cmd;
pin out float vfd_rpm_cmd;
pin out float feedback_motor_rpm;
pin out float feedback_spindle_rpm;

pin in bit enc_door_switch_configured;
pin in bit enc_door_switch_status;
pin in float enc_door_open_max_rpm;
pin in float vfd_feedback_factor;

pin out u32 spindle_fault;  //used to alert PP GUI to spindle and VFD faults
pin in bit pp_reset_ok;     //input from HAL estop latch.  When high, we are not estopped and PP is out of reset.  SLP REMOVE:  not using it
                            //this will not go hi when estop_button_in goes high and user pressed PP reset button.
                            //this goes low immediately if estop_button_in goes low (user pressed physical estop)
pin in bit estop_button_in; //actual ESTOP switch circuit.  When low, estop is active and machine DC bus is off.  
                            //When hi that means physical reset button of EStop circuit has been pressed and is lit, and we're go
pin out bit estop_fault;    //ESTOP machine when VFD faults when spindle-on is being commanded
pin in bit pp-estop_fault;  //Software ESTOP from PP

///////////Spindle orienting additions
// Inputs:
pin in s32 encoder_position;    // encoder input position (counts) from spindle
pin in float orient_angle;      // connect to motion.spindle-orient-angle
pin in s32 orient_mode;         // connect to motion.spindle-orient-mode
pin out s32 enc_err;            //hit debug
pin in bit orient_execute;      // execute indexing of spindle
pin in float orient_speed_in;   // vel command input from pid, used only when in "index" mode
pin in bit forward_in;          // forward (or reverse) to m200 from PP, when not in indexing mode
pin in float encoder_velocity;  // encoder input velocity in RPS
pin in s32 orient_encoder_cpr;  // encoder counts per rev
pin in bit spindle_lock;
pin in bit boost_disable;       //set high to disable boost
pin in bit vfd_handshake;       //Hand shake pulse from VFD to confirm VFD mode switch is done
pin in bit zindex_test;         //execute Z index testing.  Run spindle at 10K RPM, readout to spindle RPM DRO should be 10K
//TODO: Hide these after debugging
pin out float zindex_test_timer; //one sec timer
pin out bit zindex_test_flag;
pin out u32 zindex_test_count; //counts of zindex in last sec

// not used
//pin in s32 encoder_rawcounts;
//pin in s32 encoder_rawlatched;
pin out u32 orient_problem;         //TODO: REMOVE, debug only

// Bi-directional:
pin io bit zindex_enable;       //enables reset encoder counts, set from this comp, reset by hm2 encoder comp after z index is hit
pin io bit orient_set_bt30;     //set the bt30 position.
pin io s32 bt30_offset;         //offset for the Bt30 index with respect to encoder Z index location Must range from -orient_encoder_cpr/2 to orient_encoder_cpr/2
                                //this comp will set this when orient_set_bt30 is set.  Or PP GUI can set from non-volatile source.

// Outputs:
pin out u32 zindex_state;       //See ISTATE_ defines
pin out s32 finding_z_index;    //this echoes orient_mode input, and flags control of first orient when z index hasn't been seen yet
pin out bit oriented;           // feedback to linuxcnc that we've completed orientation/indexing
pin out float orient_timer;     //total time for this orient to happen (or last one took)
pin out float orient_good_timer;     // used to timeout "in position" (orienting complete)
pin out float spindle_lock_timer; //used to record how long spindle lock active, for brake cylinder filling
pin out s32 orient_fault;           //feedback to linuxcnc what error  occurred
pin out float orient_modulus;   // feedback to pid block used to control indexing
pin out u32 spindle_state;      // Normal, orienting, and spindle locked
pin out u32 last_active_spindle_state; //updated when VFD RUN goes active, so we know what vfd_freq_cmd to hold when VFD RUN goes inactive.  See vfd_hold_freq_cmd_timer
pin out s32 orient_start;       //what encoder read when orient started
pin out s32 orient_max_encoder_steps; //how many steps an orient can take before ORIENT_ERR_MAX_ROTATION happens.

//VFD mode control (i.e. motor configuration ... normal vs rapid turn motor or orienting mode on VFD)
//Defining mode1 is bit 1 MSBit, mode0 is bit 0 LSBit, then
//"0" is normal, "1" is rapid_turn, "2" is HSS, and "3" is orienting mode.
pin out bit vfd_mode0;          //ECM v1.5 J1 pins to VFD
pin out bit vfd_mode1;

//TODO: These pins don't need to be exposed for shipping product
pin out s32 vfd_mode; //the currently active vfd_mode.
pin out u32 desired_vfd_mode;   //used during vfd_mode changes, during period of time vfd_mode_switch_timer is active

pin out u32 vfd_cap;           //"cap" short for "capability" of VFD to do VFD mode switching. see VFD_CAP_? defines. 

pin out bit spindle_forward_thur;   // goes to spindle J1 "DIR" I/O
pin out bit spindle_run; // connect to m200 run pin (pass through from spindle_on when not in indexing mode) a.k.a. VFD RUN or VFD enable 
pin out bit spindle_run_last; //last state of spindle_run pin, used for inhibiting cooincident vfd_freq_cmd and spindle_run changes 
pin out bit vfd_pwr_on;     //turns on K2 contactor for VFD.  Connect to vfd-pulse HAL component in 'ecm1.hal
pin out u32 vfd_power_state; //what the VFD power state is TODO: HIDE
//TODO hide
pin out u32 look_for_fault_glitch; // TODO HIDE  = VFG_FIRST_PASS;
pin out u32 must_wait_for_stop_cmd; // TODO HIDE = 0;

pin out float vfd_pwr_on_timer; 
pin out bit target_computed; //set when we know where we're going for "new" M19 command


//pin out float encoder_timer; //not used presently ... supposed to be for using encoder to time RPS to RPM calcs, bad belt ratios, etc.
//pin out s32 last_encoder_position;  // was used with above encoder_timer for RPS calculations

pin out float vfd_enable_inhibit_timer; //This timer counts DOWN, unlike most other timers in this comp that count up
                                        //Used for two purposes:
                                        //  1) When activating VFD during orient, this timer inhibits vfd_freq_cmd (sets it to VFD_BIPOLAR_FREQ_OFFSET) after VFD RUN pin is enabled to prevent PID startup glitch
                                        //  2) During normal spindle operation, applies additional delay to the VFD enable (RUN) pin so that VFD's internal checks don't get confused.
                                        //     This delay is in addition to the one from vfd_mode_switch_timer. (run after vfd_run_inhibit_timer, if it is even active)
                                        //  See wiki VFD mode PLC error checks for more info, but here's a synopsys:  It is no longer valid to apply 0 = vfd_freq_cmd and have VFD RUN active.  
                                        //  The VFD PLC code is now programmed to see this as an error condition and faults.  We did this to aid VFD into detecting miss-communication of PP VFD mode 
                                        //  and actual VFD mode, AND/OR detecting bad wire connections to VFD that cause bad outcomes of unexpected RPM from the spindle.
                                        //  Unfortunately, simultaneously switching VFD RUN to active and vfd_freq_cmd to a non-zero can be seen by VFD as "VFD RUN = active and vfd_freq_cmd=0" because of poor
                                        //  internal sync the VFD has sampling all of its inputs.  We think this internal sync delay in the VFD is < 16 ms and we're using double this from this comp.
                                        //  So this spindle comp enforces a delay between VFD RUN active and vfd_freq_cmd inactive transistions.

//DEBUG PINS TODO: convert to internal statics for final shipping product
// these are used to deal with inhibiting vfd_freq_cmd changes as VFD RUN is disabled:
pin out float vfd_hold_freq_cmd_timer; //This timer counts DOWN, unlike most other timer in the comp that count up

pin out s32 orient_target; //exact target encoder position for orient_execute command
pin out bit orient_on_target; // encoder is within orient_band AND we have achieved oriented previously
pin out s32 orient_targetband; //within this many encoder counts of target, we call orient "done"; will be either ORIENT_TARGETBAND_VALUE or orient_targetband_override
pin in u32 orient_targetband_override;  // PP can set range in +/- encoder counts where we consider the spindle orientation is done


pin out float orient_drift; // 0: oriented within drift tolerance
                            // DRIFT_INVALID (-1): brake cylinder ORIENT_BRAKE_ACTUATION_TIME hasn't yet expired, 
                            // any_other_value: means "Fault" i.e. orient drift >= (ORIENT_TARGETBAND + ORIENT_BAND_IGNORE)
pin out float orient_raw;   //raw orient_drift, with the "hide below threshold" function
pin in float tray_in_time;  //the time from tray in command to sensor report

//TODO: remove drift_test stuff for shipping
pin in bit orient_drift_test;  //when set, orient_drift will lie every DRIFT_TEST_LOOP orients that the drift check after ATC tray in is bad.  Allows for ATC re-orient testing. 
pin out u32 orient_drift_test_cnt;

pin out bit orienting_stuck;  //goes hi when we detect spindle is not responding
pin out float orienting_stuck_timer;  //time since last movement seen on encoder during orient
pin out float orienting_boost; //RPM boost value increases ORIENT_BOOST_RPM every ORIENT_BOOST_PERIOD when active
pin out s32 orienting_stuck_last; //where we last saw the encoder during "stuck" state

//DEBUG PINS don't need to be present in shipping product
pin out bit orient_to;  //flag that that last orient timed out
pin out bit orient_P2;

//what is feed/connected to linuxcnc PID component
pin out float pidP;
pin out float pidD;
pin out float pidI;

//the values feed from .ini files for a particular mill
pin in float pidP1in;
pin in float pidI1in;
pin in float pidD1in;
pin in float pidP2in;
pin in float pidI2in;
pin in float pidD2in;
pin in float vfd_freq_offset; //usually 5000 for orient
pin in u32 P2_transition; // absolute value of encoder error that switches orient from 1st PID values to 2nd PID value
pin in float orient_boost_step;
pin in float orient_boost_min;
pin out s32 same_enc_err_cnt;
pin out s32 last_enc_err;

///////////// end of spindle orienting additions

pin out u32 vfd_handshake_state; //SLP REMOVE and replace with internal variable below DEBUG ONLY
pin out u32 vfd_handshake_cnt; // SLP REMOVE and replace with internal variable below DEBUG ONLY

function _ "Tormach Spindle HAL Component M200";

;;

#include <rtapi_math.h>


#define BIT_FALSE 0
#define BIT_TRUE  1

//Keep in sync with constants.py
#define SPINDLE_TYPE_STANDARD  0
#define SPINDLE_TYPE_SPEEDER  1
#define SPINDLE_TYPE_HISPEED  2
#define SPINDLE_TYPE_RAPID_TURN 3

#define SPINDLE_STATE_NONE 		0 	//place holder for when comp started
#define SPINDLE_STATE_NORMAL 	1  	//basically not orienting or locked
#define SPINDLE_STATE_ORIENTING 2	//spindle is orienting
#define SPINDLE_STATE_LOCKED 	3	//spindle is oriented, holding position


#define BELT_POSITION_LOW  0
#define BELT_POSITION_HIGH 1

#define SPEEDER_FACTOR_DEFAULT 3.0
#define HZ_PER_HZ_DEFAULT 20.0
#define ORIENT_HZ_PER_HZ_DEFAULT  (124)  //(345.409886398526)  //(HZ_PER_HZ_DEFAULT * 100.0) //when we go into "orient" mode, there's a 100 multiplier

// M200 feedback frequency times this is motor RPM
#define DEFAULT_VFD_FEEDBACK_FACTOR 3.0

#define RPM_CLOSE_TO_ZERO 0.1

// feedback speed must be stable at speed for this long before
// setting at-speed pin TRUE
// this avoids false positive at-speed from power on noise burst from VFD
#define AT_SPEED_DEBOUNCE_SECS 0.100
#define AT_SPEED_FORCE_DELAY_SECS 10.0  //This is the delay before forcing at-speed to be true, when at-speed-force is true

/////// SPINDLE Errors as reported on 'm200.spindle-error pin  KEEP in sync with python/constants.py
// ORDER HERE MATTERS!  Higher priority or rare errors are ranked with higher values
// if a lower ranked error is present, it may be over written before the PP UI sees it
#define SPINDLE_OK (0)                          //M200 VFD is powered and has no detected faults.  Non m200 VFDs will always return this "OK"
#define SPINDLE_OK_POSSIBLE_WIRING_ISSUE (1)    //expected temporary VFD Fault signal not seen during VFD power up.  Error effectivity is ignored.  VFD has power however you may have T41 and T42 wiring issue.
#define SPINDLE_FAULT_NO_K2 (2)                 //24VDC from VFD is not present.  K2 has not been activated yet 
#define SPINDLE_FAULT_VFD_FAULT_M5 (3)          //VFD signaled fault while not being commanded to move may be spindle door opening
#define SPINDLE_FAULT_LOST_PWR (4)              //VFD lost power. It had it. Could be spindle door opening

#define SPINDLE_FAULT_LOG_ONLY (SPINDLE_FAULT_LOST_PWR)  //spindle faults at or below this are only logged. above this point user will get indication

#define SPINDLE_FAULT_BT30 (5)                  //spindle not stationary or not in correct mode for setting BT30A
#define SPINDLE_FAULT_BT30_Z_INDEX (6)          //set BT30 attempted before z index was seen
#define SPINDLE_FAULT_ORIENT_TO  (7)            //orient time out detected.  Linuxcnc already notified user about T.O., so only log it
#define SPINDLE_FAULT_ORIENT_MAX_ROTATION (8)   //orient failed due to excessive number of revolutions.  Check encoder
#define SPINDLE_FAULT_NO_ZINDEX (9)             //orient attempted and Z index not found.  Check encoder
#define SPINDLE_FAULT_INVALID_BT30_OFFSET (10)  //BT30 orientation zero offset has not been set. Read user manual.
#define SPINDLE_FAULT_NO_ENCODER (11)           //M19 or spindle sync mode was requested yet machine has no encoder or incorrect machine type selected
#define SPINDLE_FAULT_VFD_DOESNT_SUPPORT (12)   //This machine's VFD does not support M19 or automatic VFD mode switching.
#define SPINDLE_FAULT_SPINDLE_TYPE (13)         //Orient mode requested with spindle type that doesnt support it
#define SPINDLE_FAULT_VFD_RPM  (14)             //VFD motor speed feedback absent. Check VFD wiring.
#define SPINDLE_FAULT_NO_PWR (15)               //24VDC from VFD is still not present after K2 presumably activated.  Check spindle door switch, mill circuit breakers, or VFD wiring
#define SPINDLE_FAULT_VFD_PRIOR_FAULT (16)      //spindle commanded start but VFD is faulted. Look at VFD for error code and press VFD orange button to clear fault. Or ESTOP to power cycle VFD before continuing.

//Faults SPINDLE_FAULT_MODE_SWITCH and above cause PP to call PP halt_world()
#define SPINDLE_FAULT_CRITICAL (SPINDLE_FAULT_MODE_SWITCH)  //this is a define used in PP GUI code, not here

#define SPINDLE_FAULT_MODE_SWITCH  (17)         //expected VFD Mode switch acknowledgment did not occur.  Is machine configured right, do you have VFDmx, wiring errors
#define SPINDLE_FAULT_VFD (18)                  //VFD reported a fault during rotation. Look for error code on VFD.
#define SPINDLE_FAULT_LOCK_WITHOUT_PRIOR_ORIENT (19) //This shouldn't happen. Linuxcnc state seems confused

///////// Orienting additions
//zindexing_state Bit defines
#define ISTATE_PAST     (0x10)  //set when we've completed HM2 encoder z index-enable once in past
#define ISTATE_NONE     (0)     // when we've never done an index yet
#define ISTATE_WAITING  (1)     //waiting for rotation of spindle to clear z index process
#define ISTATE_DONE     (2)     //z index of encoder has been completed
#define ISTATE_LOW_MASK (0x03)  //allows access to lower 2 bits if zindex_state
#define ISTATE_HI_MASK  (0x10)  //allows access to upper bit of zindex_state


#define BT30_OFFSET_INVALID (0x0BAD0BAD)   //Keep in sync with python/constants.py.  This is what PP will set offset to if there is no Redis value for bt30_offset

//these are from the M19 documenation, the "P" parameter sets these
#define ORIENT_NEAREST (0)
#define ORIENT_CW (1)
#define ORIENT_CCW (2)

#define ORIENT_ERR_MULTIPLE_COMMANDS (-1) //software error, shouldn't happen
#define ORIENT_ERR_NO_ZINDEX (-2) //encoder z index could not be found. Check encoder alignment or wiring
#define ORIENT_ERR_LOCK_WITHOUT_PRIOR_ORIENT (-3) //software error, shouldn't happen
// deprecated #define ORIENT_ERR_TIME_OUT (-4)
#define ORIENT_ERR_MAX_ROTATION (-5)  //abnormal orient rotation detected.  Check encoder alignment or wiring
#define ORIENT_ERR_MODE_SWITCH (-7)  //VFD mode switch failed 
#define ORIENT_ERR_NO_PWR (-8) //VFD lost power or did not power on
#define ORIENT_ERR_NO_ENCODER (-9) //machine configuration doesn't include encoder
#define ORIENT_ERR_WRONG_VFD (-10) //VFD is incapable of mode switching to orient
#define ORIENT_ERR_SPINDLE_TYPE (-11) //Spindle type is HSS or RapidTurn and orient mode requested
#define ORIENT_ERR_VFD_FAULT (-12) //vfd fault signal received while orienting
#define ORIENT_ERR_ESTOP (-13) //user ESTOP detected
#define ORIENT_ERR_NO_BT30_OFFSET (-14) //BT30 M19 R=0 position not yet set! BT30_OFFSET_INVALID 

#define ORIENT_MAX_REVS (1.5) //orient must happen within this limit of rotations.  Prevents issue where VFD not getting mode bits results in max spindle RPM run away.
                                //Note in "no Z index" case orient, we may get up to double this value, if Z index is working
                                //We will stop at ORIENT_MAX_REVS if Z index set/reset pulse doesn't work

#define ORIENT_TARGETBAND (8)  //within this range from orient target, we call it "done"
#define ORIENT_TARGETBAND_TIME   (.200) //(.400) // 303mS was observed worst case where slow slopes could cause us to think orienting is "done" when PID is still homing in
