//Handles VFD Power Sequencing and most of spindle-fault pin reporting
void _VFDPowerExec(struct __comp_state const *__comp_inst, float deltaT)
{

//"VFG_"  = Vfd Fault Glitch
#define VFG_FIRST_PASS  (0) //PP just started, first pass
#define VFG_LOOK_FOR    (1) //When PP started, VFD power was off, so we expect to see
#define VFG_SEEN        (2) //seen or already powered on when PP started

//static int look_for_fault_glitch = VFG_FIRST_PASS; 
//static int must_wait_for_stop_cmd = 0;

    if (!pp_estop_fault && !PHYSICAL_ESTOP ) // SLP check what pp_estop_fault is driven by, as we could be locked out here!
        estop_fault = BIT_FALSE;

    if (vfd_24V)
        vfd_pwr_on_timer += deltaT; //record how long the VFD has been powered up
    else vfd_pwr_on_timer = 0.0; //it's off, clear uptime 

    switch (vfd_power_state) {
        default:
        case VFD_PWR_OFF: //we always start here when PP starts
            spindle_fault = SPINDLE_OK; //default to this to clear errors
            vfd_fault_cnt = 0;
            must_wait_for_stop_cmd = 1; //reset this flag 
            look_for_fault_glitch = VFG_SEEN; //assume VFD was on before PP started, gets changed later in VFD_PWR_UP_WAIT if need be 

            vfd_pwr_state_timer = VFD_PWR_ON_PERIOD; //just keep loading/restarting this timer it gets used once we exit this state.    
            //we don't care about existing a vfd_fault here, as it gets looked at in VFD_PWR_UP_WAIT with a timer
            //NOTE vfd_24V and vfd_fault are false for a period even if VFD was on before PP started, as there's a 3ms debounce in the HAL!
            if (vfd_24V) { //the 2 known ways this happens is 1) VFD was on when PP started, or 2) PP running & user manually pushed K2 contactor to power on VFD
                vfd_power_state = VFD_PWR_UP_WAIT; //need to go to this state, where it'll exit quick, but further state determinations & timings are made
            }
            else { //VFD is not powered yet
                spindle_fault = SPINDLE_FAULT_NO_K2; //signal we're waiting for VFD to power on 
                if (spindle_on || orient_execute) {   //if user commanded spindle on
                    vfd_pwr_on = 1; //fire oneshot to K2
                    look_for_fault_glitch = VFG_LOOK_FOR; 
                    vfd_power_state = VFD_PWR_UP_WAIT;
                }
            }
            break;

        case VFD_PWR_UP_WAIT: //wait here for VFD to power up, or we time out 
            vfd_pwr_state_timer -= deltaT;
            spindle_fault = SPINDLE_FAULT_NO_K2; //default to signal we're waiting for VFD to power on, could be overwritten immediately
            if (vfd_fault)
                vfd_fault_cnt++;
            if (vfd_fault_cnt > MAX_VFD_FAULT_COUNT) { //we've seen VFD fault pin high for over 1 sec, no need to wait for vfd_pwr_state_timer to time out before declaring a spindle fault
                spindle_fault = SPINDLE_FAULT_VFD_PRIOR_FAULT; 
                vfd_power_state = VFD_PWR_ERR;
                vfd_pwr_state_timer = VFD_PWR_FADE_PERIOD;
            }
            else if(vfd_24V && !vfd_fault) { //power just turned on, or was on when PP started
                spindle_fault = SPINDLE_OK; //looks good so far
                vfd_power_state = VFD_PWR_SANE_WAIT; 
            }
            else if(vfd_pwr_state_timer <= 0.0) {  //check for time out
                if (vfd_fault) //if vfd_fault just happened, as vfd_fault_cnt handled the static long term vfd_fault case above
                    spindle_fault = SPINDLE_FAULT_VFD_PRIOR_FAULT; //vfd_24V check is 2nd, vfd_fault is higher priority and power is OK if vfd_fault is high
                else
                    spindle_fault = SPINDLE_FAULT_NO_PWR; //we waited for VFD_PWR_ON_PERIOD and no power
                vfd_power_state = VFD_PWR_ERR;
                if (!vfd_24V)
                    vfd_pwr_state_timer = 0.0;
                else vfd_pwr_state_timer = VFD_PWR_FADE_PERIOD; //in case user just opened spindle door, let VFD power die completely before restarting
                if(orient_execute || spindle_lock) {
                    orient_fault = ORIENT_ERR_NO_PWR; //flag linuxcnc that something happened.
                    orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
                }
            }
            break;

        case VFD_PWR_SANE_WAIT: //we leave this state after insanity time period expires, or we err by losing power on VFD
            if(vfd_24V) { //confirm we still have power
                //we wait different periods dependent on vfd_cap 
                if (((vfd_cap == VFD_CAP_MODE_SW) && (vfd_pwr_on_timer > VFD_PWR_SANE_PERIOD)) || (vfd_pwr_on_timer > VFD_PWR_SANE_SD_PERIOD))
                    vfd_power_state = VFD_PWR_ON;
            }
            else { // we lost power
                vfd_power_state = VFD_PWR_ERR;
                vfd_pwr_state_timer = 0.0; // power is out, no need for VFD_PWR_FADE_PERIOD verses other methods of reaching VFD_PWR_ERR state
                spindle_fault = SPINDLE_FAULT_LOST_PWR;
                if (spindle_lock || orient_execute || spindle_on) { //if spindle was commanded to move
                    orient_fault = ORIENT_ERR_NO_PWR;
                    orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
                    must_wait_for_stop_cmd = 1;
                }
            }
            if (vfd_fault) 
                look_for_fault_glitch = VFG_SEEN; //saw expected fault glitch during powering up, otherwise ignore all faults during this VFD_PWR_SANE_WAIT state

            break;

        case VFD_PWR_ON:
            vfd_pwr_on = 0; //no need to keep on, K2 is latched, plus resets for next power on attempt when/if needed
            must_wait_for_stop_cmd = 1; //reset this flag
            //post default "no_fault" spindle_fault may be over written yet
            if (look_for_fault_glitch == VFG_SEEN) //did we see exepected glitch?
                spindle_fault = SPINDLE_OK; //we saw the expected glitch during power up
            else
                spindle_fault = SPINDLE_OK_POSSIBLE_WIRING_ISSUE;

            //note vfd_fault will always preceed !vfd_24V when ESTOP hit OR user opens spindle door, by several secs
            //so realistically the only way ever see vfd_24V drop first is rare loose wire or other VFD malfunction
            if(!vfd_24V || vfd_fault) { //just lost power
                vfd_power_state = VFD_PWR_ERR;

                if (vfd_fault) //if fault was "mains power lost" because of spindle door open, we must wait for VFD power to completely "fade" before trying to restart
                    vfd_pwr_state_timer = VFD_PWR_FADE_PERIOD; //other wise a quick user FWD button push means we fail to pulse K2 contactor from VFD_PWR_OFF state, causing yet another spindle-fault
                else 
                    vfd_pwr_state_timer = 0.0; //if vfd_24V off went low, we can retrigger the K2 pulse immediately from VFD_PWR_OFF state

                if (PHYSICAL_ESTOP) {
                    spindle_fault = SPINDLE_FAULT_NO_K2; //K2 will or did drop, if "vfd_fault" more than likely a "lost mains power"
                    estop_fault = BIT_TRUE; //most likely redundant, but hit it anyway
                    //we ignore all other spindle fault conditions, and don't trigger our own ESTOP
                    if (orient_execute) { 
                        orient_fault = ORIENT_ERR_ESTOP;
                        orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
                    }
                }
                else if (spindle_on) {
                    estop_fault = BIT_TRUE; //this is a big deal, vfd faulted or lost power while running and user didn't ESTOP, so we'll do it for them!
                    if (vfd_fault) //vfd_fault takes precedence over vfd_24V state, and if 
                        spindle_fault = SPINDLE_FAULT_VFD;
                    else
                        spindle_fault = SPINDLE_FAULT_LOST_PWR; //!vfd_24V must be true because of (!vfd_24V || vfd_fault) above
                }
                else if (orient_execute || spindle_lock) {
                    estop_fault = BIT_TRUE; //another big deal
                    if (vfd_fault) {
                        orient_problem |= 0x20;
                        orient_fault = ORIENT_ERR_VFD_FAULT;
                        orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
                        spindle_fault = SPINDLE_FAULT_VFD; 
                    }
                    else {
                        spindle_fault = SPINDLE_FAULT_LOST_PWR;
                        orient_problem |= 0x10;                        
                        orient_fault = ORIENT_ERR_NO_PWR;
                        orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
                    }
                    if (spindle_lock) {
                        spindle_fault = SPINDLE_FAULT_VFD_FAULT_M5; //demote to lesser sin
                    }
                }
                else { //spindle was idle
                    //set spindle_fault so PP logs state changes
                    if (vfd_fault)
                        spindle_fault = SPINDLE_FAULT_VFD_FAULT_M5;
                    if (!vfd_24V) //vfd_24V is less likely to happen 1st, so this will over write vfd_fault if it happens, and we'll not see the vfd_fault in PP logs on purpose
                        spindle_fault = SPINDLE_FAULT_LOST_PWR;
                }
            }
            break;

        case VFD_PWR_ERR: //the only purpose this state has is to hold the present error state on the m200.spindle_fault pin until user does something to turn on spindle/VFD
            vfd_pwr_on = 0; //clear K2 one-shot trigger so it's ready if we need it for next K2 power on
            vfd_pwr_state_timer -= deltaT; //using this timer to allow VFD to completely power off after spindle door opening before trying to power it on again.
                                        //user mostly will never see this delay anyway, but was previously possible to quickly open & close spindle door, reset PP, and press "FWD" button and get a spindle-fault
            if (must_wait_for_stop_cmd && !spindle_on && !orient_execute && !spindle_lock)  //if looking for stop spindle "command", then all 3 possible movement commands must be off (false)
                must_wait_for_stop_cmd = 0;  //we've confirmed PP no longer commanding motion and can leave this state
            if (!must_wait_for_stop_cmd && (spindle_on || orient_execute) && vfd_pwr_state_timer <= 0.0)  //the user commanded spindle on. DON'T check spindle_lock as orient_execute MUST come 1st)
                vfd_power_state = VFD_PWR_OFF; //start over
            break;
    }
}

// The VFDPowerExec handles the spindle_fault pin reporting during power ups or VFD fault conditions
// so it has precidence over the spindle_fault pin.   If VFDPowerExec() is not power up sequencing
// other callers are allowed to write to the spindle_fault pin, if they have a higher priority
// fault to report
void _SpindleFaultSet(struct __comp_state const *__comp_inst, unsigned int the_fault) { //TODO: u32 doesn't work here
    if ((vfd_power_state != VFD_PWR_UP_WAIT) && (vfd_power_state != VFD_PWR_SANE_WAIT) && (the_fault > spindle_fault)) {
        spindle_fault = the_fault; 
        vfd_power_state = VFD_PWR_ERR;
        vfd_pwr_state_timer = VFD_PWR_SANE_PERIOD; //make sure we stay here long enough for PP GUI 500ms poll to see it
        //any encoder faults should force us to find spindle encoder Z index again, lest user reconnect some wire.
        //during developement if  A or B channel disconnected and reconnected, the current z index is likely wrong!
        if (the_fault >= SPINDLE_FAULT_BT30 && the_fault <= SPINDLE_FAULT_NO_ENCODER)
            zindex_state = 0;
    }
}


//_VFDCapHandler() determines the VFD's mode switching capability the first time it is called, based on the value of ack passed to it
// it returns 0 if either we received ACK or didn't care we didn't receive ACK
// it returns 1 if we did not receive ACK and we should have
// it also sets appropriate spindle_fault state of SPINDLE_FAULT_MODE_SWITCH and vfd_mode, vfd_power_state, and orient fault
// TODO: encapsulate the vfd_mode, vfd_power_state, and orient fault into SpindleFaultSet() or similar????
int _VFDCapHandler(struct __comp_state const *__comp_inst, int ack) 
{
    if (vfd_cap == VFD_CAP_UNKNOWN) { //first time pass determines the type of VFD for the running life of PP
        if (ack)
            vfd_cap = VFD_CAP_MODE_SW;
        else
            vfd_cap = VFD_CAP_NO_MODE_SW;
    }

    //MX machines (aka have encoder) MUST have VFD switching capability to switch VFD modes -- user can install VFD without mode switching capability and use it for "Normal" spindle modes
    //or we previously determined VFD does (did once) switching, it must always VFD switch thereafter.
    if (!ack && (have_encoder() || vfd_cap == VFD_CAP_MODE_SW)) {
        spindle_run = BIT_FALSE;
        _SpindleFaultSet(__comp_inst, SPINDLE_FAULT_MODE_SWITCH);
        _VFDModeSwitch(__comp_inst, VFD_MODE_DEFAULT); //jump here
        vfd_mode = VFD_MODE_DEFAULT;
        vfd_power_state = VFD_PWR_ERR;
        if (vfd_mode == VFD_MODE_ORIENT) { 
            orient_fault = ORIENT_ERR_MODE_SWITCH; //set specific orient-fault pin as linuxcnc is looking here for faults
            orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
        }
        return 1; //let caller know of fault
    }
 
    return 0; //we either received ACK or didn't care we didn't receive ACK
}


//This sets the desired_vfd_mode variable on exit and handles error handling for limited orient case caller
void _VFDModeRequest(struct __comp_state const *__comp_inst, int themode)
{
    if(themode == VFD_MODE_ORIENT) {
        if(spindle_type != SPINDLE_TYPE_STANDARD) {
            orient_fault = ORIENT_ERR_SPINDLE_TYPE;
            orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
            _SpindleFaultSet(__comp_inst, SPINDLE_FAULT_SPINDLE_TYPE);
            desired_vfd_mode = VFD_MODE_DEFAULT;
            return;
        }
        if (!have_encoder()) {  //orient requested on machine that doesn't have spindle encoder
            orient_fault = ORIENT_ERR_NO_ENCODER;
            orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
            _SpindleFaultSet(__comp_inst, SPINDLE_FAULT_NO_ENCODER); 
            desired_vfd_mode = VFD_MODE_DEFAULT;
            return;
        }
        if (vfd_cap == VFD_CAP_NO_MODE_SW) {
            orient_fault =  ORIENT_ERR_WRONG_VFD;
            orient_drift = ORIENT_DRIFT_UNRECOVERABLE;
            _SpindleFaultSet(__comp_inst, SPINDLE_FAULT_VFD_DOESNT_SUPPORT);
            desired_vfd_mode = VFD_MODE_DEFAULT;
            return;
        }
        //TODO: M19 and spindle_type == HSS or RapidTurn??
    }

    if (!((orient_execute || spindle_lock) && themode == VFD_MODE_DEFAULT)) //TODO: there's a issue with _VFDModeRequest() setting desired_vfd_mode at top of every loop of m200.comp
                                                //and we only set desired_vfd_mode = VFD_MODE_ORIENT once when orient starts
                                                //so don't overwrite desired_vfd_mode
        desired_vfd_mode = themode;
}

signed int _calcFeedback(struct __comp_state const *__comp_inst, signed int orient_direction)
{
signed int enc_feedback; //what PID gets for feedback
signed int curMod; //modulus of the current position
signed int desiredMod; //modulus of the target position
//TODO: signed int zeroMod; //modulus of z index position
signed int modulusErr; //diff between curMod nad desiredMod
signed int angle_counts;
float angle_offset;

    if (!target_computed) { //note we assumed we've checked for previous z index before calling this routine
        target_computed = 1;

        //mod both the current position and desired positions
        curMod = normalizedMod(encoder_position, orient_encoder_cpr);

        //convert orient_angle in floating degrees measure to (float) encoder counts
        angle_offset = ((orient_angle * (float)orient_encoder_cpr)/360.0) + .5;
        //convert float to int (rounding will work because we added .5 count)
        angle_counts = angle_offset;
        angle_counts = normalizedMod(angle_counts, orient_encoder_cpr);

        desiredMod = normalizedMod(angle_counts + bt30_offset, orient_encoder_cpr);

        //TODO: zeroMod = desiredMod - bt30_offset; 

        //note the resultant sign of modulusErr is for the PID feedback.
        //We want the current position, relative to desired.
        //i.e. if we're at position 150 and desired is 100, then we're returning +50 "too high"
        // which is what the PID feedback needs.  (The feedback is PID's "current position" input);

        modulusErr = normalizedMod(curMod - desiredMod,orient_encoder_cpr);

        orient_target = encoder_position - modulusErr; //this is nearest target

        if (zindex_state != (ISTATE_PAST | ISTATE_DONE)) { //If encoder Z index not seen yet, figure out orient_direction and flag finding_z_index 
            if (orient_direction == ORIENT_NEAREST) { //if M19 had no direction preference, define it here 
                if (orient_encoder_cpr >= 0) {//if CW encoder
                    if (orient_target >= encoder_position)  //if nearest was CW
                        finding_z_index = ORIENT_CW;
                    else 
                        finding_z_index = ORIENT_CCW;
                }
                else { // if CCW encoder
                    if (orient_target >= encoder_position)  //if nearest was CCW
                        finding_z_index = ORIENT_CCW;
                    else 
                        finding_z_index = ORIENT_CW;
                }
            }   
            else if (orient_direction == ORIENT_CCW) {
                finding_z_index = ORIENT_CCW;
            }
            else {
                finding_z_index = ORIENT_CW;
            }
            orient_direction = finding_z_index; //pass direction we've just set, or direction set by M19 
        }
        else if (finding_z_index) {
            orient_direction = finding_z_index; //ensure we continue in a consistent direction for the real orient
            finding_z_index = 0; //we've found z, continue on computing actual orient target as if we never did Z index find, with the one exception of orient_direction using previously defined value
        }

        //if ORIENT_CW or ORIENT_CCW, then add or sub a full turn, and possibly two if finding_z_index is active
        //warning, this "if else" and and "if else if" logic construct below makes wicked use of "else if". Missing default else are not necessary
        if(orient_encoder_cpr >= 0) { // encoder cpr is POS, so CW means counts go up
            if (orient_direction == ORIENT_CW){ //if M19 requesting CW spindle rotation, OR finding_z_index set direction ORIENT_CW
                if (orient_target < encoder_position)  //yet we calc'd a CCW rotation
                    orient_target += orient_encoder_cpr; //add a turn to force target be a CW location. Note we already know orient_encoder_cpr is positive, so adding counts to be more CW
                if (finding_z_index)  //when finding Z, orient_direction will be ORIENT_CW, but the point here is to add one more REV
                    orient_target += orient_encoder_cpr; //add another complete REV for the no Z index case
            }
            else if (orient_direction == ORIENT_CCW) { //if M19 requesting CCW spindle rotation (possble orient_direction is neither, which is why "else if" is used, OR finding_z_index set direction ORIENT_CCW
                if (orient_target > encoder_position)  //yet we calc'd a CW rotation
                    orient_target -= orient_encoder_cpr; //subtract a turn to force target to be a CCW location. note we already know orient_encoder_cpr is positive, so subracting counts to be more CCW
                if (finding_z_index)  //we know (orient_direction == ORIENT_CCW) as orient_direction != ORIENT_NEAREST (0) for finding_z_index (speaks to lack of default else)
                    orient_target -= orient_encoder_cpr;
            }
        }
        else { //encoder cpr is NEG, then CW means counts go _down_!
            if (orient_direction == ORIENT_CW) { //if M19 requesting CW spindle rotation, OR finding_z_index set direction ORIENT_CW
                if (orient_target > encoder_position)  //yet we calc'd a CCW rotation
                    orient_target += orient_encoder_cpr; //subtract a turn to force target be a more CW location. note we already know orient_encoder_cpr is negative, so we're really subtracting counts (more CW)
                if (finding_z_index)  //we know (orient_direction == ORIENT_CW   
                    orient_target += orient_encoder_cpr;
            }
            else if (orient_direction == ORIENT_CCW) { //if M19 requesting CCW spindle rotation
                if (orient_target < encoder_position)  //yet we calc'd a CW rotation
                    if (!finding_z_index) orient_target -= orient_encoder_cpr; //add a turn to force target be a more CCW location
                                    //note we already know orient_encoder_cpr is negative, so we're adding counts (more CCW)
                if (finding_z_index)  //we know (orient_direction == ORIENT_CCW
                    orient_target -= orient_encoder_cpr;
            }
        }
    } //end of if(!target_computed)

	if (orient_encoder_cpr < 0)
        enc_feedback = encoder_position - orient_target;
	else
		enc_feedback = orient_target - encoder_position;

    return enc_feedback;
}


