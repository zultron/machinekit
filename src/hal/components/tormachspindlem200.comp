void _VFDModeSwitch(struct __comp_state const *__comp_inst, int themode) {
    switch (themode) {
        default:
        case VFD_MODE_DEFAULT:
            vfd_mode0 = 0;
            vfd_mode1 = 0;
            break;
        case VFD_MODE_RAPIDTURN:
            vfd_mode0 = 1;
            vfd_mode1 = 0;
            break;
        case VFD_MODE_HISPEED:
            vfd_mode0 = 0;
            vfd_mode1 = 1;
            break;
        case VFD_MODE_ORIENT:
            orient_start = encoder_position; //record whence we came
            vfd_mode0 = 1;
            vfd_mode1 = 1;
            break;
    }
}



