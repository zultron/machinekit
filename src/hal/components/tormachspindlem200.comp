static float hz_per_cmd_hz; //this is ratio of ECM freq to resultant VFD freq out to motor, nominally 20 or 200 in orient mode
static float min_speed_freq_cmd;
static float max_speed_freq_cmd;
static unsigned int vfd_mode; //the currently active vfd_mode.  
//static unsigned int previous_vfd_mode = VFD_MODE_NONE; //we keep track of this so that we transistion vfd-freq-cmd 1/2 way through vfd_mode_switch_timer to avoid glitching VFD as it is switching modes.
static unsigned int desired_vfd_mode = VFD_MODE_NONE;   //used during vfd_mode changes, during period of time vfd_mode_switch_timer is active 
static float vfd_mode_switch_timer = 0.0;   //this timer counts down. while active (>0.0) it means VFD "RUN" pin will not be asserted. Protects VFD from glitches when switching VFD modes
                                            //also see VFD_MODE_SWITCH_DELAY notes about how this is used at 75% and 50% of VFD_MODE_SWITCH_DELAY to switch vfd-mode# pins and vfd-freq-cmd, respectively.
static float stuck_delay; //Is either (ORIENT_LONG_ORIENT_TIME) OR (ORIENT_LONG_ORIENT_TIME + VFD_MODE_SWITCH_DELAY).  Time that must pass before we start yet another timer to decide if orienting_stuck should be set.

#define FILTER_LENGTH (16)
static signed int firstFlag = 0;
static signed int fbsum;
static signed int fbvalues[FILTER_LENGTH];
static signed int fbptr; //next location circular values[] array

float fbFilter(signed int currentFb)
{
int ii;

    if(firstFlag==0){
        fbsum = currentFb * FILTER_LENGTH;
        for (ii = 0; ii< FILTER_LENGTH; ii++) {
            fbvalues[ii] = currentFb;
        }
        fbptr = 0;
    }

    firstFlag = 1;

    fbsum -= fbvalues[fbptr]; //remove the oldest value in circular buffer summation
    fbsum += currentFb; //add newest value to sum
    fbvalues[fbptr++] = currentFb; //save newest value
    if(fbptr >= FILTER_LENGTH) //loop circular buffer pointer as required
        fbptr = 0;

    return (float) ((float)fbsum/(float)FILTER_LENGTH);
}


#define vFILTER_LENGTH (500)
//static signed int vfirstFlag = 0;
static double vfbsum;
static double vfbvalues[vFILTER_LENGTH];
static signed int vfbptr; //next location circular values[] array

double vFilter(double vcurrentFb)
{
/*int ii;

    if(vfirstFlag==0){
        vfbsum = vcurrentFb * vFILTER_LENGTH;
        for (ii = 0; ii< vFILTER_LENGTH; ii++) {
            vfbvalues[ii] = vcurrentFb;
        }
        vfbptr = 0;
    }

    vfirstFlag = 1;
*/

    vfbsum = vfbsum - vfbvalues[fbptr]; //remove the oldest value in circular buffer summation
    vfbsum = vfbsum + vcurrentFb; //add newest value to sum
    vfbvalues[vfbptr++] = vcurrentFb; //save newest value
    if(vfbptr >= vFILTER_LENGTH) //loop circular buffer pointer as required
        vfbptr = 0;

    return vfbsum/((double)vFILTER_LENGTH);
}


#define FILTER_RPM_LEN (1024)
#define POSITION (0)
#define TIME (1)
#define COUNTS_TO_RPM_CONSTANT ((double)0.029296875)  // 60 secs per min / 2048 encoder resolution    TODO - magic number that doesn't work for other ENCODER_SCALE (encoder_cpr)
static double rpm[FILTER_RPM_LEN][2];  //FILTER_RPM_LEN pairs of POSITION & TIME values
static unsigned int rpmPtr;
static double rpmTime;

double filteredRPM(double position, double tNow)
{
double currentRPM;

    if (rpmPtr >= FILTER_RPM_LEN) //defensive check to range this on entry rather than exit of routine
        rpmPtr = 0;

    rpmTime += tNow; //trusting that fperiod (passed as tNow) != 0.0, otherwise divide by 0 is possible in next line

    currentRPM = (position - rpm[rpmPtr][POSITION])/(rpmTime - rpm[rpmPtr][TIME])* COUNTS_TO_RPM_CONSTANT;

    rpm[rpmPtr][POSITION] = position;
    rpm[rpmPtr][TIME] = rpmTime;

    rpmPtr++;

    return currentRPM;
}



float vfd_rpm2freq(float rpm, float pulley_ratio, float hz_per_cmd_hz, float speeder_ratio) {
    return rpm / pulley_ratio / 60.0 * hz_per_cmd_hz / speeder_ratio;
}

// return '1' if value is within tolerance of target else return 0
// tolerance is of form 0.05 to represent 5%
int is_close_enough(float val, float target, float tolerance) {
    float delta;

    delta = fabs(target - val);
    if ((delta / target) <= tolerance) {
        return 1;
    }
    return 0;
}

//returns absolute of integer
signed int iabs(signed int x)
{
    if (x >= 0)
        return x;
    return -x;
}

//returns number modulus of input number, normalized range between
//minimum  iabs(orient_encoder_cpr)/-2
//and
//maximum  iabs(orient_encoder_cpr)/2
//we have to be very careful with modulus math when adding and subtracting
//"current" and "target" positions that the -1/2 to +1/2 cpr range is true
//or results become incorrect, or we have to check for wrap conditions
signed int normalizedMod(signed int count, signed int encoder_cpr)
{
signed int modulus;

    modulus = count % iabs(encoder_cpr);

    if (modulus < 0) {
        if (modulus < iabs(encoder_cpr)/-2)
            modulus += iabs(encoder_cpr);
    }
    else {
        if (modulus > iabs(encoder_cpr)/2)
            modulus -= iabs(encoder_cpr);

    }

    return modulus;
}

//if pin isn't zero, use the value of pin, otherwise use default defined in this comp
float setValue(float x, float def_val)  {
    if((int)x)
        return x;
    return def_val;
}



