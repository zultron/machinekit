FUNCTION(_) {
    float speeder_ratio;
    float pulley_ratio;
//    float hz_per_cmd_hz;
//    float min_speed_freq_cmd;
//    float max_speed_freq_cmd;
    float tolerance;
    float vfd_feedback_ratio;
//    signed int enc_err;
    static float cw_boost_min = 0;
    static float cw_boost_step = 0;
    static float ccw_boost_min = 0;
    static float ccw_boost_step = 0;

    vfd_rpm_cmd = 0; //Defensive programming as spindle won't move unless something else below sets it

//  We need to place functions at top of FUNCTION(_) because they try to access component pins

// it appears to work to put calcFeedback() within FUNCTION(_)
// Wanted this:
// calcFeedback(void) {
//    ....
//    }
// FUNCTION(_)
//{
//....
//    calcFeedback();
//....
//}
// We got this:
// FUNCTION(_)
//{
// calcFeedback(void) {
//    ....  (no worries, doesn't get called at entry to FUNCTION(_)
//    }
//....
//    calcFeedback();
//....
//}
// It looks screwy, but it works.

signed int calcFeedback(signed int orient_direction)
{
signed int enc_feedback; //what PID gets for feedback
signed int curMod; //modulus of the current position
signed int desiredMod; //modulus of the target position
signed int modulusErr; //diff between curMod nad desiredMod
signed int angle_counts;
float angle_offset;

    if (!target_computed) { //note we assumed we've checked for previous z index before calling this routine
        target_computed = 1;

        //mod both the current position and desired positions
        curMod = normalizedMod(encoder_position, orient_encoder_cpr);

        //convert orient_angle in floating degrees measure to (float) encoder counts
        angle_offset = ((orient_angle * (float)orient_encoder_cpr)/360.0) + .5;
        //convert float to int (rounding will work because we added .5 count)
        angle_counts = angle_offset;
        angle_counts = normalizedMod(angle_counts, orient_encoder_cpr);

        desiredMod = normalizedMod(angle_counts + bt30_offset, orient_encoder_cpr);

        //note the resultant sign of modulusErr is for the PID feedback.
        //We want the current position, relative to desired.
        //i.e. if we're at position 150 and desired is 100, then we're returning +50 "too high"
        // which is what the PID feedback needs.  (The feedback is PID's "current position" input);

        modulusErr = normalizedMod(curMod - desiredMod,orient_encoder_cpr);

        orient_target = encoder_position - modulusErr; //this is nearest target

        if (zindex_state != (ISTATE_PAST | ISTATE_DONE)) { //If encoder Z index not seen yet, figure out orient_direction and flag finding_z_index 
            if (orient_direction == ORIENT_NEAREST) { //if M19 had no direction preference, define it here 
                if (orient_encoder_cpr >= 0) {//if CW encoder
                    if (orient_target >= encoder_position)  //if nearest was CW
                        finding_z_index = ORIENT_CW;
                    else 
                        finding_z_index = ORIENT_CCW;
                }
                else { // if CCW encoder
                    if (orient_target >= encoder_position)  //if nearest was CCW
                        finding_z_index = ORIENT_CCW;
                    else 
                        finding_z_index = ORIENT_CW;
                }
            }   
            else if (orient_direction == ORIENT_CCW) {
                finding_z_index = ORIENT_CCW;
            }
            else {
                finding_z_index = ORIENT_CW;
            }
            orient_direction = finding_z_index; //pass direction we've just set, or direction set by M19 
        }
        else if (finding_z_index) {
            orient_direction = finding_z_index; //ensure we continue in a consistent direction for the real orient
            finding_z_index = 0; //we've found z, continue on computing actual orient target as if we never did Z index find, with the one exception of orient_direction using previously defined value
        }

        //if ORIENT_CW or ORIENT_CCW, then add or sub a full turn, and possibly two if finding_z_index is active
        //warning, this "if else" and and "if else if" logic construct below makes wicked use of "else if". Missing default else are not necessary
        if(orient_encoder_cpr >= 0) { // encoder cpr is POS, so CW means counts go up
            if (orient_direction == ORIENT_CW){ //if M19 requesting CW spindle rotation, OR finding_z_index set direction ORIENT_CW
                if (orient_target < encoder_position)  //yet we calc'd a CCW rotation
                    orient_target += orient_encoder_cpr; //add a turn to force target be a CW location. Note we already know orient_encoder_cpr is positive, so adding counts to be more CW
                if (finding_z_index)  //when finding Z, orient_direction will be ORIENT_CW, but the point here is to add one more REV
                    orient_target += orient_encoder_cpr; //add another complete REV for the no Z index case
            }
            else if (orient_direction == ORIENT_CCW) { //if M19 requesting CCW spindle rotation (possble orient_direction is neither, which is why "else if" is used, OR finding_z_index set direction ORIENT_CCW
                if (orient_target > encoder_position)  //yet we calc'd a CW rotation
                    orient_target -= orient_encoder_cpr; //subtract a turn to force target to be a CCW location. note we already know orient_encoder_cpr is positive, so subracting counts to be more CCW
                if (finding_z_index)  //we know (orient_direction == ORIENT_CCW) as orient_direction != ORIENT_NEAREST (0) for finding_z_index (speaks to lack of default else)
                    orient_target -= orient_encoder_cpr;
            }
        }
        else { //encoder cpr is NEG, then CW means counts go _down_!
            if (orient_direction == ORIENT_CW) { //if M19 requesting CW spindle rotation, OR finding_z_index set direction ORIENT_CW
                if (orient_target > encoder_position)  //yet we calc'd a CCW rotation
                    orient_target += orient_encoder_cpr; //subtract a turn to force target be a more CW location. note we already know orient_encoder_cpr is negative, so we're really subtracting counts (more CW)
                if (finding_z_index)  //we know (orient_direction == ORIENT_CW   
                    orient_target += orient_encoder_cpr;
            }
            else if (orient_direction == ORIENT_CCW) { //if M19 requesting CCW spindle rotation
                if (orient_target < encoder_position)  //yet we calc'd a CW rotation
                    if (!finding_z_index) orient_target -= orient_encoder_cpr; //add a turn to force target be a more CCW location
                                    //note we already know orient_encoder_cpr is negative, so we're adding counts (more CCW)
                if (finding_z_index)  //we know (orient_direction == ORIENT_CCW
                    orient_target -= orient_encoder_cpr;
            }
        }
    } //end of if(!target_computed)

	if (orient_encoder_cpr < 0)
        enc_feedback = encoder_position - orient_target;
	else
		enc_feedback = orient_target - encoder_position;

    return enc_feedback;
}

