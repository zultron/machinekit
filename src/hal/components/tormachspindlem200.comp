pin in bit at_speed_force;  //A debugging pin.  When set, at_speed will be forced true after AT_SPEED_FORCE_DELAY_SECS
// connect to motion.spindle-at-speed
pin out bit at_speed;
pin out float at_speed_debounce;
pin out float at_speed_force_timer;

// connect to motion.spindle-on
pin in bit spindle_on;

// this inbits the spindle from turning no matter what is commanded
pin in bit disable;

// connect to UI
pin out float speed_out_rps;
pin out float speed_out;

// hi-low belt position
pin in bit belt_position;

pin in float lowbelt_min_rpm;
pin in float lowbelt_max_rpm;

pin in float highbelt_min_rpm;
pin in float highbelt_max_rpm;

pin in float highbelt_ratio;
pin in float lowbelt_ratio;

pin in float highbelt_step_rpm;     // rpm below which we expand tolerance when in highbelt
pin in float lowbelt_step_rpm;      // rpm below which we expand tolerance when in lowbelt
pin in float highbelt_tol_below;    // what the rpm tolerance is below highbelt-step-rpm
pin in float highbelt_tol_above;    // what the rpm tolerance is above or equal to highbelt-step-rpm
pin in float lowbelt_tol_below;     // what the rpm tolerance is below lowbelt-step-rpm
pin in float lowbelt_tol_above;     // what the rpm tolerance is above or equal to lowbelt-step-rpm
pin in float hispeed_step_rpm;      // rpm below which we expand tolerance with highspeed spindle 
pin in float hispeed_tol_below;     // what the rpm tolerance is below highspeed-step-rpm
pin in float hispeed_tol_above;     // what the rpm tolerance is above or equal to highspeed-step-rpm

